                color: {TokyoNightTheme.COLORS['blue']};
                font-weight: bold;
            }}
            
            QCalendarWidget QMenu {{
                background-color: {TokyoNightTheme.COLORS['background']};
                color: {TokyoNightTheme.COLORS['foreground']};
            }}
            
            QPushButton {{
                background-color: {TokyoNightTheme.COLORS['dark_gray']};
                color: {TokyoNightTheme.COLORS['foreground']};
                border: 1px solid {TokyoNightTheme.COLORS['gray']};
                border-radius: 4px;
                padding: 8px;
                font-weight: bold;
            }}
            
