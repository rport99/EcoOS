class SmartEventManager:
    """Intelligent event management with suggestions and analytics"""
    
    def __init__(self):
        self.event_history = []
        self.categories = {
            'work': ['Meeting', 'Deadline', 'Conference'],
            'personal': ['Birthday', 'Anniversary', 'Family'],
            'health': ['Doctor', 'Exercise', 'Meditation'],
            'social': ['Party', 'Dinner', 'Gathering'],
            'education': ['Class', 'Study', 'Workshop']
        }
        
    def suggest_event_time(self, event_name: str, duration_hours: int = 1) -> Tuple[str, str]:
        """Suggest optimal time for an event based on its type"""
        current_time = datetime.datetime.now()
        
        if any(word in event_name.lower() for word in ['meeting', 'work', 'deadline']):
            # Suggest work hours (9 AM - 5 PM)
            suggested_time = current_time.replace(hour=9, minute=0, second=0)
        elif any(word in event_name.lower() for word in ['exercise', 'gym', 'yoga']):
            # Suggest morning or evening for health
            suggested_time = current_time.replace(hour=7, minute=0, second=0)
        elif any(word in event_name.lower() for word in ['dinner', 'party', 'social']):
            # Suggest evening for social events
            suggested_time = current_time.replace(hour=19, minute=0, second=0)
        else:
            # Default to 2 PM
            suggested_time = current_time.replace(hour=14, minute=0, second=0)
        
        end_time = suggested_time + datetime.timedelta(hours=duration_hours)
        return suggested_time.strftime("%H:%M"), end_time.strftime("%H:%M")
    
    def categorize_event(self, event_name: str) -> str:
        """Categorize event based on keywords"""
        event_lower = event_name.lower()
        
        for category, keywords in self.categories.items():
            for keyword in keywords:
                if keyword.lower() in event_lower:
                    return category
                
        # Check for keyword patterns
        if any(word in event_lower for word in ['meet', 'work', 'office', 'project']):
            return 'work'
        elif any(word in event_lower for word in ['birthday', 'anniversary', 'family']):
            return 'personal'
        elif any(word in event_lower for word in ['doctor', 'health', 'exercise', 'gym']):
            return 'health'
        elif any(word in event_lower for word in ['party', 'dinner', 'friends', 'social']):
            return 'social'
        
        return 'other'
    
    def analyze_productivity(self, events: Dict) -> Dict:
        """Analyze productivity patterns from events"""
        analysis = {
            'work_hours': 0,
            'personal_hours': 0,
            'social_hours': 0,
            'health_hours': 0,
            'education_hours': 0,
            'total_events': 0,
            'busiest_day': None,
            'busiest_day_count': 0
        }
        
        day_count = {}
        
        for date_str, event_list in events.items():
            day_events = len(event_list)
            day_count[date_str] = day_events
            
            for event in event_list:
                category = self.categorize_event(event['name'])
                if category in analysis:
                    analysis[f'{category}_hours'] += 1
                analysis['total_events'] += 1
        
        if day_count:
            analysis['busiest_day'] = max(day_count, key=day_count.get)
            analysis['busiest_day_count'] = day_count[analysis['busiest_day']]
        
        return analysis


class EventEditDialog(QDialog):
    """Dialog for adding/editing events"""
    
    def __init__(self, events, smart_manager, parent=None, date=None, event_index=None, event_data=None):
        super().__init__(parent)
        self.events = events
        self.smart_manager = smart_manager
        self.parent_app = parent
        self.date = date
        self.event_index = event_index
        self.is_edit_mode = event_data is not None
        
        self.setWindowTitle("Edit Event" if self.is_edit_mode else "Add Event")
        self.setGeometry(300, 300, 500, 600)
        
        self.init_ui(event_data or {})
    
    def init_ui(self, event_data):
        layout = QVBoxLayout()
        
        # Event name
        name_group = QGroupBox("Event Details")
        name_layout = QVBoxLayout()
        
        self.event_name_label = QLabel("Event Name:")
        self.event_name_edit = QLineEdit()
        self.event_name_edit.setText(event_data.get('name', ''))
        self.event_name_edit.textChanged.connect(self.on_name_changed)
        name_layout.addWidget(self.event_name_label)
        name_layout.addWidget(self.event_name_edit)
        
        # Category selection
        self.category_label = QLabel("Category:")
        self.category_combo = QComboBox()
        self.category_combo.addItems(['work', 'personal', 'health', 'social', 'education', 'other'])
        name_layout.addWidget(self.category_label)
        name_layout.addWidget(self.category_combo)
        
        # Set current category
        category = event_data.get('category', 'other')
        index = self.category_combo.findText(category)
        if index >= 0:
            self.category_combo.setCurrentIndex(index)
        
        name_group.setLayout(name_layout)
        layout.addWidget(name_group)
        
        # Date and time
        time_group = QGroupBox("Date & Time")
        time_layout = QVBoxLayout()
        
        self.date_label = QLabel("Date:")
        self.date_edit = QCalendarWidget()
        if self.date:
            date_obj = QDate.fromString(self.date, "yyyy-MM-dd")
            self.date_edit.setSelectedDate(date_obj)
        else:
            self.date_edit.setSelectedDate(QDate.currentDate())
        time_layout.addWidget(self.date_label)
        time_layout.addWidget(self.date_edit)
        
        self.time_label = QLabel("Time:")
        time_hbox = QHBoxLayout()
        self.time_edit = QTimeEdit()
        
        # Set current time
        if 'time' in event_data:
            time_obj = QTime.fromString(event_data['time'], "HH:mm")
            self.time_edit.setTime(time_obj)
        else:
            self.time_edit.setTime(QTime.currentTime())
        
        self.duration_combo = QComboBox()
        self.duration_combo.addItems(['30 min', '1 hour', '1.5 hours', '2 hours', '3 hours', 'All day'])
        self.duration_combo.setCurrentIndex(1)
        
        self.suggest_time_btn = QPushButton("Suggest Time")
        self.suggest_time_btn.clicked.connect(self.suggest_time)
        
        time_hbox.addWidget(self.time_edit)
        time_hbox.addWidget(QLabel("Duration:"))
        time_hbox.addWidget(self.duration_combo)
        time_hbox.addWidget(self.suggest_time_btn)
        time_layout.addLayout(time_hbox)
        
        time_group.setLayout(time_layout)
        layout.addWidget(time_group)
        
        # Additional details
        details_group = QGroupBox("Additional Details")
        details_layout = QVBoxLayout()
        
        self.location_label = QLabel("Location (optional):")
        self.location_edit = QLineEdit()
        self.location_edit.setText(event_data.get('location', ''))
        details_layout.addWidget(self.location_label)
        details_layout.addWidget(self.location_edit)
        
        self.description_label = QLabel("Description (optional):")
        self.description_edit = QTextEdit()
        self.description_edit.setMaximumHeight(100)
        self.description_edit.setText(event_data.get('description', ''))
        details_layout.addWidget(self.description_label)
        details_layout.addWidget(self.description_edit)
        
        details_group.setLayout(details_layout)
        layout.addWidget(details_group)
        
        # Reminder options
        reminder_layout = QHBoxLayout()
        self.reminder_checkbox = QCheckBox("Set Reminder")
        self.reminder_checkbox.setChecked(event_data.get('reminder', True))
        reminder_layout.addWidget(self.reminder_checkbox)
        
        self.recurring_checkbox = QCheckBox("Recurring Event")
        self.recurring_checkbox.setChecked(event_data.get('recurring', False))
        reminder_layout.addWidget(self.recurring_checkbox)
        
        layout.addLayout(reminder_layout)
        
        # Recurrence options
        self.recurrence_group = QGroupBox("Recurrence Options")
        recurrence_layout = QVBoxLayout()
        
        recurrence_hbox = QHBoxLayout()
        self.recurrence_combo = QComboBox()
        self.recurrence_combo.addItems(['Daily', 'Weekly', 'Monthly', 'Yearly'])
        recurrence_hbox.addWidget(QLabel("Repeat:"))
        recurrence_hbox.addWidget(self.recurrence_combo)
        
        self.recurrence_count_label = QLabel("For how many times?")
        self.recurrence_count = QLineEdit()
        self.recurrence_count.setText("10")
        self.recurrence_count.setMaximumWidth(50)
        recurrence_hbox.addWidget(self.recurrence_count_label)
        recurrence_hbox.addWidget(self.recurrence_count)
        
        recurrence_layout.addLayout(recurrence_hbox)
        self.recurrence_group.setLayout(recurrence_layout)
        self.recurrence_group.setVisible(self.recurring_checkbox.isChecked())
        layout.addWidget(self.recurrence_group)
        
        self.recurring_checkbox.toggled.connect(self.recurrence_group.setVisible)
        
        # Auto-categorize
        self.auto_categorize_checkbox = QCheckBox("Auto-categorize event")
        self.auto_categorize_checkbox.setChecked(True)
        layout.addWidget(self.auto_categorize_checkbox)
        
        # Buttons
        button_layout = QHBoxLayout()
        
        if self.is_edit_mode:
            self.save_button = QPushButton("Save Changes")
            self.save_button.clicked.connect(self.save_changes)
            self.save_button.setStyleSheet(f"""
                background-color: {TokyoNightTheme.COLORS['blue']};
                color: {TokyoNightTheme.COLORS['background']};
                font-weight: bold;
                padding: 10px;
            """)
        else:
            self.save_button = QPushButton("Add Event")
            self.save_button.clicked.connect(self.save_changes)
            self.save_button.setStyleSheet(f"""
                background-color: {TokyoNightTheme.COLORS['green']};
                color: {TokyoNightTheme.COLORS['background']};
                font-weight: bold;
                padding: 10px;
            """)
        
        if self.is_edit_mode:
            self.delete_button = QPushButton("Delete Event")
            self.delete_button.clicked.connect(self.delete_event)
            self.delete_button.setStyleSheet(f"""
                background-color: {TokyoNightTheme.COLORS['red']};
                color: {TokyoNightTheme.COLORS['background']};
                font-weight: bold;
                padding: 10px;
            """)
            button_layout.addWidget(self.delete_button)
        
        self.cancel_button = QPushButton("Cancel")
        self.cancel_button.clicked.connect(self.reject)
        
        button_layout.addWidget(self.save_button)
        button_layout.addWidget(self.cancel_button)
        
        layout.addLayout(button_layout)
        self.setLayout(layout)
    
    def on_name_changed(self, text):
        """Update category based on event name"""
        if self.auto_categorize_checkbox.isChecked() and text.strip():
            category = self.smart_manager.categorize_event(text)
            index = self.category_combo.findText(category)
            if index >= 0:
                self.category_combo.setCurrentIndex(index)
    
    def suggest_time(self):
        """Suggest optimal time for the event"""
        event_name = self.event_name_edit.text().strip()
        if event_name:
            duration_map = {
                '30 min': 0.5,
                '1 hour': 1,
                '1.5 hours': 1.5,
                '2 hours': 2,
                '3 hours': 3,
                'All day': 8
            }
            duration = duration_map.get(self.duration_combo.currentText(), 1)
            
            suggested_start, suggested_end = self.smart_manager.suggest_event_time(event_name, duration)
            
            # Parse suggested time
            suggested_time = QTime.fromString(suggested_start, "HH:mm")
            self.time_edit.setTime(suggested_time)
            
            QMessageBox.information(self, "Time Suggested", 
                                  f"Suggested time: {suggested_start} - {suggested_end}")
    
    def save_changes(self):
        """Save the event"""
        event_name = self.event_name_edit.text().strip()
        event_date = self.date_edit.selectedDate().toString("yyyy-MM-dd")
        event_time = self.time_edit.time().toString("HH:mm")
        category = self.category_combo.currentText()
        
        if not event_name:
            QMessageBox.warning(self, "Warning", "Please enter an event name!")
            return
        
        # Auto-categorize if enabled
        if self.auto_categorize_checkbox.isChecked():
            category = self.smart_manager.categorize_event(event_name)
        
        # Create event object
        event_data = {
            "name": event_name,
            "time": event_time,
            "category": category,
            "reminder": self.reminder_checkbox.isChecked(),
            "description": self.description_edit.toPlainText().strip(),
            "location": self.location_edit.text().strip(),
            "last_modified": datetime.datetime.now().isoformat(),
            "duration": self.duration_combo.currentText(),
            "recurring": self.recurring_checkbox.isChecked(),
        }
        
        if self.recurring_checkbox.isChecked():
            event_data["recurrence"] = {
                "type": self.recurrence_combo.currentText().lower(),
                "count": int(self.recurrence_count.text() or "10")
            }
        
        if self.is_edit_mode:
            # Update existing event
            if event_date != self.date:
                # Remove from old date
                if self.date in self.events and self.event_index is not None:
                    if self.event_index < len(self.events[self.date]):
                        del self.events[self.date][self.event_index]
                    
                    if not self.events[self.date]:
                        del self.events[self.date]
            
            # Add to new date
            if event_date not in self.events:
                self.events[event_date] = []
            
            if event_date == self.date and self.event_index is not None:
                # Same date, update in place
                if self.event_index < len(self.events[event_date]):
                    self.events[event_date][self.event_index] = event_data
                else:
                    self.events[event_date].append(event_data)
            else:
                # New date, add to end
                self.events[event_date].append(event_data)
        else:
            # Add new event
            if event_date not in self.events:
                self.events[event_date] = []
            self.events[event_date].append(event_data)
            
            # Handle recurrence
            if self.recurring_checkbox.isChecked():
                self.create_recurring_events(event_date, event_data)
        
        # Sort events by time
        if event_date in self.events:
            self.events[event_date].sort(key=lambda x: x['time'])
        
        self.accept()
    
    def create_recurring_events(self, start_date: str, base_event: dict):
        """Create recurring events"""
        try:
            start = datetime.datetime.strptime(start_date, "%Y-%m-%d").date()
            recurrence = base_event["recurrence"]
            count = recurrence["count"]
            
            # Remove recurrence info from base event
            event_copy = base_event.copy()
            event_copy.pop("recurrence", None)
            event_copy.pop("recurring", None)
            event_copy["recurring_parent"] = start_date
            
            for i in range(1, count + 1):
                if recurrence["type"] == "daily":
                    new_date = start + datetime.timedelta(days=i)
                elif recurrence["type"] == "weekly":
                    new_date = start + datetime.timedelta(weeks=i)
                elif recurrence["type"] == "monthly":
                    # Simple monthly recurrence (same day of month)
                    month = start.month + i
                    year = start.year
                    while month > 12:
                        month -= 12
                        year += 1
                    new_date = datetime.date(year, month, start.day)
                elif recurrence["type"] == "yearly":
                    new_date = datetime.date(start.year + i, start.month, start.day)
                else:
                    break
                
                date_str = new_date.isoformat()
                if date_str not in self.events:
                    self.events[date_str] = []
                
                self.events[date_str].append(event_copy.copy())
        except Exception as e:
            print(f"Error creating recurring events: {e}")
    
    def delete_event(self):
        """Delete the event"""
        reply = QMessageBox.question(
            self, "Confirm Delete",
            "Are you sure you want to delete this event?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            self.event_deleted = True
            self.accept()


class CalendarApp(QMainWindow):
    """Enhanced Calendar Application with Tokyo Night Theme"""
    
    # Signals for event updates
    event_added = pyqtSignal(dict)
    event_updated = pyqtSignal(dict)
    event_deleted = pyqtSignal(str, int)
    
    def __init__(self):
        super().__init__()
        self.setWindowTitle("EcoOS Calendar Pro")
        self.setGeometry(100, 100, 1400, 900)
        
        # Initialize smart features
        self.smart_manager = SmartEventManager()
        self.location = self.get_user_location()
        
        # Load settings
        self.settings = self.load_settings()
        
        # Setup timers
        self.setup_timers()
        
        # Initialize data
        self.events = {}
        self.notes = {}
        self.tags = {}
        self.load_all_data()
        
        # Setup UI
        self.init_ui()
        
        # Apply theme
        self.apply_theme_colors()
        
        # Start background tasks
        self.start_background_tasks()
        
        # Track current event selection
        self.current_event_index = -1
        self.current_event_date = ""
    
    def load_settings(self) -> Dict:
        """Load application settings"""
        settings_file = os.path.expanduser("~/Documents/calendar_settings.json")
        default_settings = {
            'theme': 'tokyo_night',
            'notifications': True,
            'sound_alerts': True,
            'auto_backup': True,
            'weather_enabled': False,
            'productivity_tracking': True,
            'default_view': 'month',
            'week_start': 'monday',
            'time_format': '24h',
            'first_run': True
        }
        
        if os.path.exists(settings_file):
            try:
                with open(settings_file, 'r') as f:
                    loaded = json.load(f)
                    # Merge with defaults
                    for key, value in default_settings.items():
                        if key not in loaded:
                            loaded[key] = value
                    return loaded
            except:
                return default_settings
        return default_settings
    
    def save_settings(self):
        """Save application settings"""
        settings_file = os.path.expanduser("~/Documents/calendar_settings.json")
        with open(settings_file, 'w') as f:
            json.dump(self.settings, f, indent=4)
    
    def get_user_location(self) -> Optional[Dict]:
        """Get user location for weather and timezone"""
        if not WEATHER_AVAILABLE:
            return None
            
        try:
            geolocator = Nominatim(user_agent="eco_calendar")
            # For privacy, use a default location or implement proper location services
            location = geolocator.geocode("New York")
            if location:
                return {
                    'city': 'New York',
                    'latitude': location.latitude,
                    'longitude': location.longitude
                }
        except:
            pass
        return None
    
    def setup_timers(self):
        """Setup all timers for the application"""
        # Reminder timer
        self.reminder_timer = QTimer(self)
        self.reminder_timer.timeout.connect(self.check_for_reminders)
        self.reminder_timer.start(30000)  # Check every 30 seconds
        
        # Update timer
        self.update_timer = QTimer(self)
        self.update_timer.timeout.connect(self.update_display)
        self.update_timer.start(1000)  # Update every second
        
        # Auto-save timer
        self.autosave_timer = QTimer(self)
        self.autosave_timer.timeout.connect(self.auto_save)
        self.autosave_timer.start(300000)  # Auto-save every 5 minutes
    
    def load_all_data(self):
        """Load all data from files"""
        self.load_events()
        self.load_notes()
        self.load_tags()
        
    def load_events(self):
        """Load events from file"""
        events_file = os.path.expanduser("~/Documents/calendar_events.json")
        if os.path.exists(events_file):
            try:
                with open(events_file, 'r') as f:
                    loaded_events = json.load(f)
                    # Convert old format if needed
                    self.events = self.convert_events_format(loaded_events)
            except Exception as e:
                print(f"Error loading events: {e}")
                self.events = {}
        else:
            self.events = {}
    
    def convert_events_format(self, events_data):
        """Convert events from old format if needed"""
        if isinstance(events_data, dict):
            return events_data
        return {}
    
    def load_notes(self):
        """Load notes from file"""
        notes_file = os.path.expanduser("~/Documents/calendar_notes.json")
        if os.path.exists(notes_file):
            try:
                with open(notes_file, 'r') as f:
                    self.notes = json.load(f)
            except:
                self.notes = {}
        else:
            self.notes = {}
    
    def load_tags(self):
        """Load tags from file"""
        tags_file = os.path.expanduser("~/Documents/calendar_tags.json")
        if os.path.exists(tags_file):
            try:
                with open(tags_file, 'r') as f:
                    self.tags = json.load(f)
            except:
                self.tags = {}
        else:
            self.tags = {}
    
    def save_events(self):
        """Save events to file"""
        events_file = os.path.expanduser("~/Documents/calendar_events.json")
        try:
            with open(events_file, 'w') as f:
                json.dump(self.events, f, indent=4)
        except Exception as e:
            print(f"Error saving events: {e}")
    
    def save_notes(self):
        """Save notes to file"""
        notes_file = os.path.expanduser("~/Documents/calendar_notes.json")
        with open(notes_file, 'w') as f:
            json.dump(self.notes, f, indent=4)
    
    def save_tags(self):
        """Save tags to file"""
        tags_file = os.path.expanduser("~/Documents/calendar_tags.json")
        with open(tags_file, 'w') as f:
            json.dump(self.tags, f, indent=4)
    
    def auto_save(self):
        """Auto-save all data"""
        self.save_events()
        self.save_notes()
        self.save_tags()
        print("Auto-save completed")
    
    def apply_theme_colors(self):
        """Apply theme-specific colors to UI elements"""
        # Set font
        font = QFont("Fira Code", 10)
        self.setFont(font)
    
