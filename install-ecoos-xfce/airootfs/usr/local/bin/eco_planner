    def update_display(self):
        """Update all display elements"""
        current_datetime = QDateTime.currentDateTime()
        self.date_time_label.setText(current_datetime.toString("dddd, MMMM d, yyyy\nhh:mm:ss AP"))
        
        # Update selected date label
        selected_date = self.calendar.selectedDate()
        self.selected_date_label.setText(f"Selected Date: {selected_date.toString('dddd, MMMM d, yyyy')}")
        
        # Update status bar
        selected_date_str = selected_date.toString("yyyy-MM-dd")
        event_count = len(self.events.get(selected_date_str, []))
        self.statusBar().showMessage(f"{event_count} events for {selected_date_str}")
        
        # Update stats
        self.update_stats()
        
        # Highlight dates with events on calendar
        self.highlight_event_dates()
    
    def highlight_event_dates(self):
        """Highlight dates that have events on the calendar"""
        format = QTextCharFormat()
        format.setBackground(QBrush(QColor(TokyoNightTheme.COLORS['selection'])))
        format.setForeground(QBrush(QColor(TokyoNightTheme.COLORS['white'])))
        
        # Clear previous highlights
        for date_str in self.events.keys():
            date = QDate.fromString(date_str, "yyyy-MM-dd")
            self.calendar.setDateTextFormat(date, QTextCharFormat())
        
        # Apply new highlights
        for date_str, event_list in self.events.items():
            if event_list:
                date = QDate.fromString(date_str, "yyyy-MM-dd")
                self.calendar.setDateTextFormat(date, format)
    
    def update_stats(self):
        """Update productivity statistics"""
        analysis = self.smart_manager.analyze_productivity(self.events)
        stats_text = f"📊 Stats: {analysis['total_events']} events | "
        stats_text += f"Work: {analysis['work_hours']} | "
        stats_text += f"Personal: {analysis['personal_hours']} | "
        stats_text += f"Health: {analysis['health_hours']}"
        self.stats_label.setText(stats_text)
    
    def go_to_today(self):
        """Go to today's date"""
        self.calendar.setSelectedDate(QDate.currentDate())
        self.show_events_for_date(QDate.currentDate())
    
    def show_week_view(self):
        """Show week view"""
        self.tab_widget.setCurrentIndex(1)  # Switch to week view tab
        self.update_week_view()
    
    def show_month_view(self):
        """Show month view"""
        self.tab_widget.setCurrentIndex(2)  # Switch to month view tab
    
    def update_week_view(self):
        """Update the week view table"""
        # Clear table
        for row in range(24):
            for col in range(1, 8):
                self.week_table.setItem(row, col, QTableWidgetItem(""))
        
        # Get current week dates
        selected_date = self.calendar.selectedDate()
        start_of_week = selected_date.addDays(-selected_date.dayOfWeek() + 1)  # Monday
        
        # Fill week view
        for day in range(7):
            current_date = start_of_week.addDays(day)
            date_str = current_date.toString("yyyy-MM-dd")
            
            if date_str in self.events:
                for event in self.events[date_str]:
                    try:
                        hour = int(event['time'].split(':')[0])
                        event_text = f"{event['time']} - {event['name']}"
                        
                        # Get existing text or create new
                        item = self.week_table.item(hour, day + 1)
                        if item:
                            current_text = item.text()
                            if current_text:
                                event_text = current_text + "\n" + event_text
                        
                        new_item = QTableWidgetItem(event_text)
                        
                        # Color code by category
                        category = event.get('category', 'other')
                        color_map = {
                            'work': TokyoNightTheme.COLORS['blue'],
                            'personal': TokyoNightTheme.COLORS['green'],
                            'health': TokyoNightTheme.COLORS['cyan'],
                            'social': TokyoNightTheme.COLORS['magenta'],
                            'education': TokyoNightTheme.COLORS['yellow'],
                            'other': TokyoNightTheme.COLORS['gray']
                        }
                        new_item.setForeground(QColor(color_map.get(category, TokyoNightTheme.COLORS['gray'])))
                        
                        # Store event data in item
                        new_item.setData(Qt.UserRole, (date_str, event))
                        
                        self.week_table.setItem(hour, day + 1, new_item)
                    except:
                        continue
    
    def on_week_cell_clicked(self, row, column):
        """Handle week view cell click"""
        if column == 0 or column > 7:  # Time column or out of range
            return
        
        item = self.week_table.item(row, column)
        if item and item.data(Qt.UserRole):
            date_str, event_data = item.data(Qt.UserRole)
            date = QDate.fromString(date_str, "yyyy-MM-dd")
            self.calendar.setSelectedDate(date)
            self.show_events_for_date(date)
            self.tab_widget.setCurrentIndex(0)  # Switch to day view
            
            # Highlight the event in the list
            self.highlight_event_in_list(event_data)
    
    def highlight_event_in_list(self, target_event):
        """Highlight a specific event in the event list"""
        for i in range(self.event_list.count()):
            item = self.event_list.item(i)
            if item.data(Qt.UserRole):
                event_date, event_index = item.data(Qt.UserRole)
                current_event = self.events[event_date][event_index]
                
                if (current_event['name'] == target_event['name'] and 
                    current_event['time'] == target_event['time']):
                    self.event_list.setCurrentItem(item)
                    self.on_event_clicked(item)
                    break
    
    def show_events_for_date(self, date):
        """Show events for the selected date"""
        selected_date = date.toString("yyyy-MM-dd")
        self.current_event_date = selected_date
        self.event_list.clear()
        self.event_details.clear()
        
        events = self.events.get(selected_date, [])
        if events:
            for index, event in enumerate(events):
                item_text = f"{event['time']} - {event['name']}"
                
                # Add icons
                if event.get('reminder'):
                    item_text += " ⏰"
                if event.get('completed'):
                    item_text += " ✓"
                if event.get('recurring'):
                    item_text += " 🔄"
                
                # Add category
                if event.get('category'):
                    item_text += f" [{event['category']}]"
                
                item = QListWidgetItem(item_text)
                
                # Store event reference
                item.setData(Qt.UserRole, (selected_date, index))
                
                # Color code by category
                category = event.get('category', 'other')
                color_map = {
                    'work': TokyoNightTheme.COLORS['blue'],
                    'personal': TokyoNightTheme.COLORS['green'],
                    'health': TokyoNightTheme.COLORS['cyan'],
                    'social': TokyoNightTheme.COLORS['magenta'],
                    'education': TokyoNightTheme.COLORS['yellow'],
                    'other': TokyoNightTheme.COLORS['gray']
                }
                item.setForeground(QColor(color_map.get(category, TokyoNightTheme.COLORS['gray'])))
                
                # Strike through completed events
                if event.get('completed'):
                    font = item.font()
                    font.setStrikeOut(True)
                    item.setFont(font)
                
                self.event_list.addItem(item)
        else:
            self.event_list.addItem("No events for this date")
        
        # Update week view if it's visible
        if self.tab_widget.currentIndex() == 1:  # Week view
            self.update_week_view()
        
        # Update all events tree
        self.update_all_events_tree()
    
    def on_event_selection_changed(self):
        """Enable/disable edit/delete buttons based on selection"""
        current_item = self.event_list.currentItem()
        has_selection = bool(current_item and 
                            current_item.text() != "No events for this date")
        
        self.edit_event_btn.setEnabled(has_selection)
        self.delete_event_btn.setEnabled(has_selection)
        self.complete_event_btn.setEnabled(has_selection)
        
        # Store current selection info
        if has_selection and current_item.data(Qt.UserRole):
            self.current_event_date, self.current_event_index = current_item.data(Qt.UserRole)
    
    def on_event_clicked(self, item):
        """Handle event item click"""
        if not item.data(Qt.UserRole):
            return
            
        selected_date, event_index = item.data(Qt.UserRole)
        events = self.events.get(selected_date, [])
        
        if event_index < len(events):
            event = events[event_index]
            
            # Display event details
            details = f"""
            <h3>{event['name']}</h3>
            <b>Date:</b> {selected_date}<br>
            <b>Time:</b> {event['time']}<br>
            <b>Duration:</b> {event.get('duration', '1 hour')}<br>
            <b>Category:</b> {event.get('category', 'Uncategorized')}<br>
            <b>Reminder:</b> {'Yes' if event.get('reminder') else 'No'}<br>
            <b>Recurring:</b> {'Yes' if event.get('recurring') else 'No'}<br>
            <b>Status:</b> {'Completed' if event.get('completed') else 'Pending'}<br>
            """
            if event.get('description'):
                details += f"<b>Description:</b><br>{event['description']}<br>"
            if event.get('location'):
                details += f"<b>Location:</b> {event['location']}<br>"
            if event.get('last_modified'):
                details += f"<b>Last Modified:</b> {event['last_modified']}<br>"
            
            self.event_details.setHtml(details)
    
    def on_all_event_clicked(self, item):
        """Handle click on event in all events tree"""
        if item.data(0, Qt.UserRole):
            date_str, event_index = item.data(0, Qt.UserRole)
            date = QDate.fromString(date_str, "yyyy-MM-dd")
            self.calendar.setSelectedDate(date)
            self.show_events_for_date(date)
            self.tab_widget.setCurrentIndex(0)  # Switch to day view
            
            # Highlight the event
            events = self.events.get(date_str, [])
            if event_index < len(events):
                self.highlight_event_in_list(events[event_index])
    
    def update_all_events_tree(self):
        """Update the all events tree view"""
        self.all_events_tree.clear()
        
        for date_str, event_list in sorted(self.events.items()):
            date_item = QTreeWidgetItem(self.all_events_tree)
            date_item.setText(0, date_str)
            date_item.setExpanded(True)
            
            for index, event in enumerate(event_list):
                event_item = QTreeWidgetItem(date_item)
                event_item.setText(0, date_str)
                event_item.setText(1, event['time'])
                event_item.setText(2, event['name'])
                event_item.setText(3, event.get('category', 'other'))
                event_item.setText(4, 'Completed' if event.get('completed') else 'Pending')
                
                # Store reference
                event_item.setData(0, Qt.UserRole, (date_str, index))
                
                # Color code
                category = event.get('category', 'other')
                color_map = {
                    'work': TokyoNightTheme.COLORS['blue'],
                    'personal': TokyoNightTheme.COLORS['green'],
                    'health': TokyoNightTheme.COLORS['cyan'],
                    'social': TokyoNightTheme.COLORS['magenta'],
                    'education': TokyoNightTheme.COLORS['yellow']
                }
                if category in color_map:
                    for col in range(5):
                        event_item.setForeground(col, QBrush(QColor(color_map[category])))
    
    def on_note_clicked(self, item):
        """Handle note item click"""
        note_text = item.text()
        date = note_text.split(" - ")[0]
        if date in self.notes:
            self.note_details.setHtml(f"<h3>Note for {date}</h3><p>{self.notes[date]}</p>")
    
    def add_event(self):
        """Add a new event"""
        selected_date = self.calendar.selectedDate().toString("yyyy-MM-dd")
        dialog = EventEditDialog(self.events, self.smart_manager, self, selected_date)
        if dialog.exec_() == QDialog.Accepted:
            self.show_events_for_date(self.calendar.selectedDate())
            self.save_events()
            self.update_stats()
    
    def edit_event(self):
        """Edit the selected event"""
        current_item = self.event_list.currentItem()
        if not current_item:
            return
        
        if not current_item.data(Qt.UserRole):
            return
            
        selected_date, event_index = current_item.data(Qt.UserRole)
        events = self.events.get(selected_date, [])
        
        if event_index < len(events):
            event_data = events[event_index]
            dialog = EventEditDialog(self.events, self.smart_manager, self, 
                                    selected_date, event_index, event_data)
            if dialog.exec_() == QDialog.Accepted:
                if hasattr(dialog, 'event_deleted') and dialog.event_deleted:
                    # Event was deleted
                    pass
                self.show_events_for_date(self.calendar.selectedDate())
                self.save_events()
                self.update_stats()
    
    def delete_event(self):
        """Delete the selected event"""
        current_item = self.event_list.currentItem()
        if not current_item:
            return
        
        if not current_item.data(Qt.UserRole):
            return
        
        # Confirm deletion
        reply = QMessageBox.question(
            self, "Confirm Delete",
            "Are you sure you want to delete this event?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply != QMessageBox.Yes:
            return
        
        selected_date, event_index = current_item.data(Qt.UserRole)
        
        if selected_date in self.events and event_index < len(self.events[selected_date]):
            # Remove the event
            deleted_event = self.events[selected_date].pop(event_index)
            
            # If no more events for this date, remove the date key
            if not self.events[selected_date]:
                del self.events[selected_date]
            
            # Update UI
            self.show_events_for_date(self.calendar.selectedDate())
            self.event_details.clear()
            self.save_events()
            self.update_stats()
            
            QMessageBox.information(self, "Success", "Event deleted successfully!")
    
    def mark_event_complete(self):
        """Mark selected event as complete"""
        current_item = self.event_list.currentItem()
        if not current_item:
            return
        
        if not current_item.data(Qt.UserRole):
            return
        
        selected_date, event_index = current_item.data(Qt.UserRole)
        
        if selected_date in self.events and event_index < len(self.events[selected_date]):
            event = self.events[selected_date][event_index]
            event['completed'] = True
            event['completed_date'] = datetime.datetime.now().isoformat()
            
            # Update UI
            self.show_events_for_date(self.calendar.selectedDate())
            self.save_events()
            
            QMessageBox.information(self, "Success", "Event marked as complete!")
    
    def add_note(self):
        """Add or edit a note"""
        selected_date = self.calendar.selectedDate().toString("yyyy-MM-dd")
        current_note = self.notes.get(selected_date, "")
        
        note, ok = QInputDialog.getMultiLineText(self, "Add/Edit Note", 
                                                 f"Enter note for {selected_date}:",
                                                 current_note)
        if ok and note.strip():
            self.notes[selected_date] = note.strip()
            self.save_notes()
            self.update_notes_list()
    
    def update_notes_list(self):
        """Update the notes list display"""
        self.notes_list.clear()
        for date, note in sorted(self.notes.items(), reverse=True):
            preview = note[:50] + "..." if len(note) > 50 else note
            self.notes_list.addItem(f"{date} - {preview}")
    
    def delete_note(self):
        """Delete selected note"""
        current_item = self.notes_list.currentItem()
        if current_item:
            date = current_item.text().split(" - ")[0]
            if date in self.notes:
                del self.notes[date]
                self.save_notes()
                self.update_notes_list()
                self.note_details.clear()
    
    def search_events(self, search_text):
        """Search events by name or description"""
        self.search_results.clear()
        
        if not search_text.strip():
            return
        
        search_lower = search_text.lower()
        results = []
        
        for date_str, event_list in self.events.items():
            for index, event in enumerate(event_list):
                if (search_lower in event['name'].lower() or 
                    (event.get('description') and search_lower in event['description'].lower())):
                    results.append((date_str, index, event))
        
        # Display results
        for date_str, index, event in results[:10]:  # Limit to 10 results
            date_obj = datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
            date_display = date_obj.strftime("%b %d")
            item_text = f"{date_display} {event['time']} - {event['name']}"
            
            item = QListWidgetItem(item_text)
            item.setData(Qt.UserRole, (date_str, index))
            self.search_results.addItem(item)
    
    def on_search_result_clicked(self, item):
        """Handle search result click"""
        if item.data(Qt.UserRole):
            date_str, event_index = item.data(Qt.UserRole)
            date = QDate.fromString(date_str, "yyyy-MM-dd")
            self.calendar.setSelectedDate(date)
            self.show_events_for_date(date)
            self.tab_widget.setCurrentIndex(0)  # Switch to day view
            
            # Highlight the event
            events = self.events.get(date_str, [])
            if event_index < len(events):
                self.highlight_event_in_list(events[event_index])
    
    def check_for_reminders(self):
        """Check for upcoming event reminders"""
        if not self.settings.get('notifications', True):
            return
            
        current_time = datetime.datetime.now()
        current_date = current_time.date().isoformat()
        current_hour_minute = current_time.time().strftime("%H:%M")
        
        events_for_today = self.events.get(current_date, [])
        
        for event in events_for_today:
            if (event.get("reminder") and not event.get('completed') and 
                event["time"][:5] == current_hour_minute and 
                not event.get('notified')):
                
                # Show notification
                self.show_notification(f"Reminder: {event['name']}", 
                                      f"You have an event at {event['time']}")
                
                # Play sound if enabled
                if self.settings.get('sound_alerts', True):
                    self.play_reminder_sound()
                
                # Mark as notified to prevent multiple notifications
                event["notified"] = True
        
        self.save_events()
    
    def show_notification(self, title: str, message: str):
        """Show a system notification"""
        msg = QMessageBox()
        msg.setIcon(QMessageBox.Information)
        msg.setWindowTitle(title)
        msg.setText(message)
        msg.setStandardButtons(QMessageBox.Ok)
        
        # Make dialog stay on top
        msg.setWindowFlags(msg.windowFlags() | Qt.WindowStaysOnTopHint)
        msg.exec_()
    
    def play_reminder_sound(self):
        """Play reminder sound"""
        try:
            subprocess.run(["paplay", "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"])
        except:
            # Fallback to system beep
            print("\a")
    
    def export_events(self):
        """Export events to JSON file"""
        from PyQt5.QtWidgets import QFileDialog
        
        file_path, _ = QFileDialog.getSaveFileName(
            self, "Export Events", 
            os.path.expanduser("~/Documents/calendar_export.json"),
            "JSON Files (*.json);;All Files (*)"
        )
        
        if file_path:
            try:
                export_data = {
                    'events': self.events,
                    'notes': self.notes,
                    'export_date': datetime.datetime.now().isoformat(),
                    'version': '2.0'
                }
                
                with open(file_path, 'w') as f:
                    json.dump(export_data, f, indent=4)
                QMessageBox.information(self, "Success", "Events exported successfully!")
            except Exception as e:
                QMessageBox.critical(self, "Error", f"Failed to export: {str(e)}")
    
    def import_events(self):
        """Import events from JSON file"""
        from PyQt5.QtWidgets import QFileDialog
        
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Import Events",
            os.path.expanduser("~/Documents"),
            "JSON Files (*.json);;All Files (*)"
        )
        
        if file_path and os.path.exists(file_path):
            try:
                with open(file_path, 'r') as f:
                    imported_data = json.load(f)
                
                if 'events' in imported_data:
                    self.events.update(imported_data['events'])
                if 'notes' in imported_data:
                    self.notes.update(imported_data['notes'])
                
                self.save_events()
                self.save_notes()
                self.show_events_for_date(self.calendar.selectedDate())
                QMessageBox.information(self, "Success", "Events imported successfully!")
            except Exception as e:
                QMessageBox.critical(self, "Error", f"Failed to import: {str(e)}")
    
    def backup_data(self):
        """Backup all calendar data"""
        backup_dir = os.path.expanduser("~/Documents/calendar_backups")
        os.makedirs(backup_dir, exist_ok=True)
        
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_file = os.path.join(backup_dir, f"calendar_backup_{timestamp}.json")
        
        backup_data = {
            'events': self.events,
            'notes': self.notes,
            'tags': self.tags,
            'settings': self.settings,
            'backup_date': timestamp
        }
        
        try:
            with open(backup_file, 'w') as f:
                json.dump(backup_data, f, indent=4)
            QMessageBox.information(self, "Success", f"Backup created at:\n{backup_file}")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Backup failed: {str(e)}")
    
    def restore_data(self):
        """Restore data from backup"""
        from PyQt5.QtWidgets import QFileDialog
        
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Restore Backup",
            os.path.expanduser("~/Documents/calendar_backups"),
            "JSON Files (*.json);;All Files (*)"
        )
        
        if file_path:
            reply = QMessageBox.warning(
                self, "Confirm Restore",
                "Restoring will overwrite current data. Continue?",
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No
            )
            
            if reply == QMessageBox.Yes:
                try:
                    with open(file_path, 'r') as f:
                        backup_data = json.load(f)
                    
                    self.events = backup_data.get('events', {})
                    self.notes = backup_data.get('notes', {})
                    self.tags = backup_data.get('tags', {})
                    
                    self.save_events()
                    self.save_notes()
                    self.save_tags()
                    
                    self.show_events_for_date(self.calendar.selectedDate())
                    QMessageBox.information(self, "Success", "Data restored successfully!")
                except Exception as e:
                    QMessageBox.critical(self, "Error", f"Restore failed: {str(e)}")
    
    def print_calendar(self):
        """Print calendar view"""
        QMessageBox.information(self, "Print", "Print functionality will be implemented in a future version.")
    
    def show_preferences(self):
        """Show preferences dialog"""
        dialog = QDialog(self)
        dialog.setWindowTitle("Preferences")
        dialog.setGeometry(400, 400, 500, 400)
        
        layout = QVBoxLayout()
        
        # Theme selection
        theme_group = QGroupBox("Appearance")
        theme_layout = QVBoxLayout()
        
        theme_combo = QComboBox()
        theme_combo.addItems(['Tokyo Night', 'Dark', 'Light', 'System'])
        current_theme = self.settings.get('theme', 'tokyo_night').replace('_', ' ').title()
        index = theme_combo.findText(current_theme)
        if index >= 0:
            theme_combo.setCurrentIndex(index)
        
        theme_layout.addWidget(QLabel("Theme:"))
        theme_layout.addWidget(theme_combo)
        theme_group.setLayout(theme_layout)
        layout.addWidget(theme_group)
        
        # Notifications
        notify_group = QGroupBox("Notifications")
        notify_layout = QVBoxLayout()
        
        notify_checkbox = QCheckBox("Enable notifications")
        notify_checkbox.setChecked(self.settings.get('notifications', True))
        notify_layout.addWidget(notify_checkbox)
        
        sound_checkbox = QCheckBox("Enable sound alerts")
        sound_checkbox.setChecked(self.settings.get('sound_alerts', True))
        notify_layout.addWidget(sound_checkbox)
        
        notify_group.setLayout(notify_layout)
        layout.addWidget(notify_group)
        
        # Auto-save
        autosave_group = QGroupBox("Auto-save")
        autosave_layout = QVBoxLayout()
        
        autosave_checkbox = QCheckBox("Enable auto-save every 5 minutes")
        autosave_checkbox.setChecked(self.settings.get('auto_backup', True))
        autosave_layout.addWidget(autosave_checkbox)
        
        autosave_group.setLayout(autosave_layout)
        layout.addWidget(autosave_group)
        
        # Buttons
        button_layout = QHBoxLayout()
        save_button = QPushButton("Save")
        cancel_button = QPushButton("Cancel")
        
        def save_preferences():
            self.settings['theme'] = theme_combo.currentText().lower().replace(' ', '_')
            self.settings['notifications'] = notify_checkbox.isChecked()
            self.settings['sound_alerts'] = sound_checkbox.isChecked()
            self.settings['auto_backup'] = autosave_checkbox.isChecked()
            self.save_settings()
            dialog.accept()
            QMessageBox.information(self, "Preferences Saved", 
                                  "Some changes may require restarting the application.")
        
        save_button.clicked.connect(save_preferences)
        cancel_button.clicked.connect(dialog.reject)
        
        button_layout.addWidget(save_button)
        button_layout.addWidget(cancel_button)
        layout.addLayout(button_layout)
        
        dialog.setLayout(layout)
        dialog.exec_()
    
    def change_theme(self):
        """Change application theme"""
        themes = ['Tokyo Night', 'Dark', 'Light', 'System']
        theme, ok = QInputDialog.getItem(self, "Change Theme", 
                                        "Select theme:", themes, 0, False)
        if ok:
            self.settings['theme'] = theme.lower().replace(' ', '_')
            self.save_settings()
            QMessageBox.information(self, "Theme Changed", 
                                  "Please restart the application to apply the new theme.")
    
    def refresh_view(self):
        """Refresh the current view"""
        self.show_events_for_date(self.calendar.selectedDate())
    
    def clear_completed_events(self):
        """Clear all completed events"""
        reply = QMessageBox.question(
            self, "Clear Completed Events",
            "This will remove all completed events. Continue?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            events_to_remove = []
            
            for date_str, event_list in list(self.events.items()):
                new_list = [event for event in event_list if not event.get('completed')]
                if new_list:
                    self.events[date_str] = new_list
                else:
                    events_to_remove.append(date_str)
            
            for date_str in events_to_remove:
                del self.events[date_str]
            
            self.save_events()
            self.show_events_for_date(self.calendar.selectedDate())
            QMessageBox.information(self, "Success", "Completed events cleared!")
    
    def show_productivity_stats(self):
        """Show productivity statistics"""
        analysis = self.smart_manager.analyze_productivity(self.events)
        
        stats_html = """
        <html>
        <head>
        <style>
        body { color: #a9b1d6; font-family: Arial, sans-serif; }
        h2 { color: #7aa2f7; }
        .stat { margin: 10px 0; padding: 10px; background: #1a1b26; border-radius: 5px; }
        .progress { height: 20px; background: #414868; border-radius: 10px; margin: 5px 0; }
        .progress-bar { height: 100%; background: #7aa2f7; border-radius: 10px; }
        </style>
        </head>
        <body>
        <h2>📈 Productivity Statistics</h2>
        """
        
        total = analysis['total_events']
        if total > 0:
            categories = ['work', 'personal', 'health', 'social', 'education']
            colors = {
                'work': '#7aa2f7',
                'personal': '#9ece6a', 
                'health': '#7dcfff',
                'social': '#bb9af7',
                'education': '#e0af68'
            }
            
            for category in categories:
                value = analysis[f'{category}_hours']
                percentage = (value / total) * 100 if total > 0 else 0
                color = colors.get(category, '#7aa2f7')
                stats_html += f"""
                <div class="stat">
                    <strong>{category.title()}:</strong> {value} events ({percentage:.1f}%)
                    <div class="progress">
                        <div class="progress-bar" style="width: {percentage}%; background-color: {color}"></div>
                    </div>
                </div>
                """
        
        stats_html += f"""
        <div class="stat">
            <strong>Total Events:</strong> {total}
        </div>
        """
        
        if analysis['busiest_day']:
            stats_html += f"""
            <div class="stat">
                <strong>Busiest Day:</strong> {analysis['busiest_day']} ({analysis['busiest_day_count']} events)
            </div>
            """
        
        stats_html += "</body></html>"
        
        dialog = QDialog(self)
        dialog.setWindowTitle("Productivity Statistics")
        dialog.setGeometry(200, 200, 500, 400)
        
        layout = QVBoxLayout()
        text_browser = QTextBrowser()
        text_browser.setHtml(stats_html)
        layout.addWidget(text_browser)
        
        close_btn = QPushButton("Close")
        close_btn.clicked.connect(dialog.accept)
        layout.addWidget(close_btn)
        
        dialog.setLayout(layout)
        dialog.exec_()
    
    def suggest_events(self):
        """Suggest events based on patterns"""
        suggestions = [
            {"name": "Weekly Team Meeting", "time": "10:00", "category": "work"},
            {"name": "Morning Exercise", "time": "07:00", "category": "health"},
            {"name": "Plan Next Week", "time": "16:00", "category": "work"},
            {"name": "Family Dinner", "time": "19:00", "category": "personal"}
        ]
        
        selected_date = self.calendar.selectedDate().toString("yyyy-MM-dd")
        
        suggestion_text = "<h3>Event Suggestions:</h3><ul>"
        for suggestion in suggestions:
            suggestion_text += f"<li>{suggestion['time']} - {suggestion['name']} [{suggestion['category']}]</li>"
        suggestion_text += "</ul>"
        
        reply = QMessageBox.question(self, "Event Suggestions", 
                                    suggestion_text + "<br>Add these events to today?",
                                    QMessageBox.Yes | QMessageBox.No)
        
        if reply == QMessageBox.Yes:
            if selected_date not in self.events:
                self.events[selected_date] = []
            
            for suggestion in suggestions:
                self.events[selected_date].append({
                    "name": suggestion['name'],
                    "time": suggestion['time'],
                    "category": suggestion['category'],
                    "reminder": True,
                    "description": "Suggested by AI assistant",
                    "duration": "1 hour",
                    "last_modified": datetime.datetime.now().isoformat()
                })
            
            # Sort events
            self.events[selected_date].sort(key=lambda x: x['time'])
            
            self.save_events()
            self.show_events_for_date(self.calendar.selectedDate())
            QMessageBox.information(self, "Success", "Suggested events added!")
    
    def import_holidays(self):
        """Import holidays for the current year"""
        current_year = datetime.datetime.now().year
        holidays = {
            f"{current_year}-01-01": "New Year's Day",
            f"{current_year}-12-25": "Christmas Day",
            f"{current_year}-07-04": "Independence Day",
            f"{current_year}-11-11": "Veterans Day",
            f"{current_year}-12-31": "New Year's Eve"
        }
        
        reply = QMessageBox.question(
            self, "Import Holidays",
            f"Import common holidays for {current_year}?",
            QMessageBox.Yes | QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            added_count = 0
            for date_str, name in holidays.items():
                if date_str not in self.events:
                    self.events[date_str] = []
                
                # Check if holiday already exists
                holiday_exists = any(event['name'] == name for event in self.events[date_str])
                if not holiday_exists:
                    self.events[date_str].append({
                        "name": name,
                        "time": "00:00",
                        "category": "personal",
                        "reminder": False,
                        "description": "Public holiday",
                        "duration": "All day",
                        "last_modified": datetime.datetime.now().isoformat()
                    })
                    added_count += 1
            
            self.save_events()
            self.show_events_for_date(self.calendar.selectedDate())
            QMessageBox.information(self, "Success", f"Added {added_count} holidays!")
    
