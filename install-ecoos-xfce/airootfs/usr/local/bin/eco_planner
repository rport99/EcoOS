        dialog.setLayout(layout)
        dialog.exec_()
    
    def start_background_tasks(self):
        """Start background tasks"""
        # Update notes list
        self.update_notes_list()
        
        # Update all events tree
        self.update_all_events_tree()
        
        # Check for overdue events
        self.check_overdue_events()
        
        # Show welcome message on first run
        if self.settings.get('first_run', True):
            self.show_welcome_message()
            self.settings['first_run'] = False
            self.save_settings()
    
    def show_welcome_message(self):
        """Show welcome message on first run"""
        welcome_text = """
        <h2>Welcome to EcoOS Calendar Pro!</h2>
        <p>Thank you for choosing our calendar application. Here are some quick tips:</p>
        <ul>
        <li>Double-click dates to quickly add events</li>
        <li>Use the search box to find events</li>
        <li>Try the Week View for better scheduling</li>
        <li>Configure notifications in Preferences</li>
        <li>Backup your data regularly</li>
        </ul>
        <p>Enjoy using EcoOS Calendar Pro!</p>
        """
        
        QMessageBox.information(self, "Welcome", welcome_text)
    
    def check_overdue_events(self):
        """Check for overdue events"""
        current_date = datetime.date.today().isoformat()
        
        # Check if any events from previous days still have reminders set
        for date_str in list(self.events.keys()):
            if date_str < current_date:
                for event in self.events[date_str]:
                    if event.get('reminder') and not event.get('completed'):
                        # Could add a notification here
                        pass
    
    def closeEvent(self, event):
        """Handle application close"""
        # Auto-save before closing
        self.auto_save()
        
        # Save window state
        self.settings['window_geometry'] = self.saveGeometry().toBase64().data().decode('utf-8')
        self.save_settings()
        
        event.accept()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("EcoOS Calendar Pro")
    app.setApplicationDisplayName("EcoOS Calendar Pro")
    
    # Apply Tokyo Night theme
    TokyoNightTheme.apply(app)
    
    # Set application style
    app.setStyle(QStyleFactory.create('Fusion'))
    
    window = CalendarApp()
    
    # Restore window geometry if saved
    if 'window_geometry' in window.settings:
        try:
            import base64
            geometry_data = window.settings['window_geometry']
            geometry_bytes = base64.b64decode(geometry_data)
            window.restoreGeometry(QByteArray(geometry_bytes))
        except Exception as e:
            print(f"Could not restore window geometry: {e}")
    
    window.show()
    
    sys.exit(app.exec_())


if __name__ == "__main__":
    # Check for optional dependencies
    if not WEATHER_AVAILABLE:
        print("Note: Weather features disabled. Install geopy: pip install geopy")
    if not API_AVAILABLE:
        print("Note: Some API features disabled. Install requests: pip install requests")
    
    main()