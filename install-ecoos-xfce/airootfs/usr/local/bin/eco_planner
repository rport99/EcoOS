class TokyoNightTheme:
    """Tokyo Night Theme colors and styling"""
    
    # Colors from Tokyo Night theme
    COLORS = {
        'background': '#1a1b26',
        'foreground': '#a9b1d6',
        'selection': '#283457',
        'comment': '#565f89',
        'blue': '#7aa2f7',
        'cyan': '#7dcfff',
        'green': '#9ece6a',
        'magenta': '#bb9af7',
        'orange': '#ff9e64',
        'red': '#f7768e',
        'yellow': '#e0af68',
        'black': '#1a1b26',
        'white': '#c0caf5',
        'gray': '#565f89',
        'dark_gray': '#414868',
    }
    
    @staticmethod
    def apply(app: QApplication):
        """Apply Tokyo Night theme to the application"""
        palette = QPalette()
        
        # Base colors
        palette.setColor(QPalette.Window, QColor(TokyoNightTheme.COLORS['background']))
        palette.setColor(QPalette.WindowText, QColor(TokyoNightTheme.COLORS['foreground']))
        palette.setColor(QPalette.Base, QColor(TokyoNightTheme.COLORS['background']))
        palette.setColor(QPalette.AlternateBase, QColor(TokyoNightTheme.COLORS['dark_gray']))
        palette.setColor(QPalette.ToolTipBase, QColor(TokyoNightTheme.COLORS['background']))
        palette.setColor(QPalette.ToolTipText, QColor(TokyoNightTheme.COLORS['foreground']))
        palette.setColor(QPalette.Text, QColor(TokyoNightTheme.COLORS['foreground']))
        palette.setColor(QPalette.Button, QColor(TokyoNightTheme.COLORS['dark_gray']))
        palette.setColor(QPalette.ButtonText, QColor(TokyoNightTheme.COLORS['foreground']))
        palette.setColor(QPalette.BrightText, QColor(TokyoNightTheme.COLORS['red']))
        palette.setColor(QPalette.Link, QColor(TokyoNightTheme.COLORS['blue']))
        palette.setColor(QPalette.Highlight, QColor(TokyoNightTheme.COLORS['selection']))
        palette.setColor(QPalette.HighlightedText, QColor(TokyoNightTheme.COLORS['white']))
        
        app.setPalette(palette)
        
        # Additional styling
        app.setStyleSheet(f"""
