class TokyoNightTheme:
    """Tokyo Night Theme colors and styling"""
    
    # Colors from Tokyo Night theme
    COLORS = {
        'background': '#1a1b26',
        'foreground': '#a9b1d6',
        'selection': '#283457',
        'comment': '#565f89',
        'blue': '#7aa2f7',
        'cyan': '#7dcfff',
