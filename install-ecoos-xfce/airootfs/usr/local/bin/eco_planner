class SmartEventManager:
    """Intelligent event management with suggestions and analytics"""
    
    def __init__(self):
        self.event_history = []
        self.categories = {
            'work': ['Meeting', 'Deadline', 'Conference'],
            'personal': ['Birthday', 'Anniversary', 'Family'],
            'health': ['Doctor', 'Exercise', 'Meditation'],
            'social': ['Party', 'Dinner', 'Gathering'],
            'education': ['Class', 'Study', 'Workshop']
        }
        
    def suggest_event_time(self, event_name: str, duration_hours: int = 1) -> Tuple[str, str]:
        """Suggest optimal time for an event based on its type"""
        current_time = datetime.datetime.now()
        
        if any(word in event_name.lower() for word in ['meeting', 'work', 'deadline']):
            # Suggest work hours (9 AM - 5 PM)
            suggested_time = current_time.replace(hour=9, minute=0, second=0)
        elif any(word in event_name.lower() for word in ['exercise', 'gym', 'yoga']):
            # Suggest morning or evening for health
            suggested_time = current_time.replace(hour=7, minute=0, second=0)
        elif any(word in event_name.lower() for word in ['dinner', 'party', 'social']):
            # Suggest evening for social events
            suggested_time = current_time.replace(hour=19, minute=0, second=0)
        else:
            # Default to 2 PM
            suggested_time = current_time.replace(hour=14, minute=0, second=0)
        
        end_time = suggested_time + datetime.timedelta(hours=duration_hours)
        return suggested_time.strftime("%H:%M"), end_time.strftime("%H:%M")
    
    def categorize_event(self, event_name: str) -> str:
        """Categorize event based on keywords"""
        event_lower = event_name.lower()
        
        for category, keywords in self.categories.items():
            for keyword in keywords:
                if keyword.lower() in event_lower:
                    return category
                
        # Check for keyword patterns
        if any(word in event_lower for word in ['meet', 'work', 'office', 'project']):
            return 'work'
        elif any(word in event_lower for word in ['birthday', 'anniversary', 'family']):
            return 'personal'
        elif any(word in event_lower for word in ['doctor', 'health', 'exercise', 'gym']):
            return 'health'
        elif any(word in event_lower for word in ['party', 'dinner', 'friends', 'social']):
            return 'social'
        
        return 'other'
    
    def analyze_productivity(self, events: Dict) -> Dict:
        """Analyze productivity patterns from events"""
        analysis = {
            'work_hours': 0,
            'personal_hours': 0,
            'social_hours': 0,
            'health_hours': 0,
            'total_events': 0,
            'busiest_day': None
        }
        
        day_count = {}
        
        for date_str, event_list in events.items():
            day_events = len(event_list)
            day_count[date_str] = day_events
            
            for event in event_list:
                category = self.categorize_event(event['name'])
                if category in analysis:
                    analysis[f'{category}_hours'] += 1
                analysis['total_events'] += 1
        
        if day_count:
            analysis['busiest_day'] = max(day_count, key=day_count.get)
        
        return analysis


class CalendarApp(QMainWindow):
    """Enhanced Calendar Application with Tokyo Night Theme"""
    
    # Signals for event updates
    event_added = pyqtSignal(dict)
    event_updated = pyqtSignal(dict)
    event_deleted = pyqtSignal(str, int)
    
    def __init__(self):
        super().__init__()
        self.setWindowTitle("EcoOS Calendar Pro")
        self.setGeometry(100, 100, 1200, 800)
        
        # Initialize smart features
        self.smart_manager = SmartEventManager()
        self.location = self.get_user_location()
        
        # Load settings
        self.settings = self.load_settings()
        
        # Setup timers
        self.setup_timers()
        
        # Initialize data
        self.events = {}
        self.notes = {}
        self.load_all_data()
        
        # Setup UI
        self.init_ui()
        
        # Apply theme
        self.apply_theme_colors()
        
        # Start background tasks
        self.start_background_tasks()
    
    def load_settings(self) -> Dict:
        """Load application settings"""
        settings_file = os.path.expanduser("~/Documents/calendar_settings.json")
        default_settings = {
            'theme': 'tokyo_night',
            'notifications': True,
            'sound_alerts': True,
            'auto_backup': True,
            'weather_enabled': False,
            'productivity_tracking': True
        }
        
        if os.path.exists(settings_file):
            try:
                with open(settings_file, 'r') as f:
                    return {**default_settings, **json.load(f)}
            except:
                return default_settings
        return default_settings
    
    def save_settings(self):
        """Save application settings"""
        settings_file = os.path.expanduser("~/Documents/calendar_settings.json")
        with open(settings_file, 'w') as f:
            json.dump(self.settings, f, indent=4)
    
    def get_user_location(self) -> Optional[Dict]:
        """Get user location for weather and timezone"""
        if not WEATHER_AVAILABLE:
            return None
            
        try:
            geolocator = Nominatim(user_agent="eco_calendar")
            # For privacy, use a default location or implement proper location services
            location = geolocator.geocode("New York")
            if location:
                return {
                    'city': 'New York',
                    'latitude': location.latitude,
                    'longitude': location.longitude
                }
        except:
            pass
        return None
    
    def setup_timers(self):
        """Setup all timers for the application"""
        # Reminder timer
        self.reminder_timer = QTimer(self)
        self.reminder_timer.timeout.connect(self.check_for_reminders)
        self.reminder_timer.start(30000)  # Check every 30 seconds
        
        # Update timer
        self.update_timer = QTimer(self)
        self.update_timer.timeout.connect(self.update_display)
        self.update_timer.start(1000)  # Update every second
        
        # Auto-save timer
        self.autosave_timer = QTimer(self)
        self.autosave_timer.timeout.connect(self.auto_save)
        self.autosave_timer.start(300000)  # Auto-save every 5 minutes
    
    def load_all_data(self):
        """Load all data from files"""
        self.load_events()
        self.load_notes()
        
    def load_events(self):
        """Load events from file"""
        events_file = os.path.expanduser("~/Documents/calendar_events.json")
        if os.path.exists(events_file):
            try:
                with open(events_file, 'r') as f:
                    self.events = json.load(f)
            except:
                self.events = {}
        else:
            self.events = {}
    
    def load_notes(self):
        """Load notes from file"""
        notes_file = os.path.expanduser("~/Documents/calendar_notes.json")
        if os.path.exists(notes_file):
            try:
                with open(notes_file, 'r') as f:
                    self.notes = json.load(f)
            except:
                self.notes = {}
        else:
            self.notes = {}
    
    def save_events(self):
        """Save events to file"""
        events_file = os.path.expanduser("~/Documents/calendar_events.json")
        with open(events_file, 'w') as f:
            json.dump(self.events, f, indent=4)
    
    def save_notes(self):
        """Save notes to file"""
        notes_file = os.path.expanduser("~/Documents/calendar_notes.json")
        with open(notes_file, 'w') as f:
            json.dump(self.notes, f, indent=4)
    
    def auto_save(self):
        """Auto-save all data"""
        self.save_events()
        self.save_notes()
        print("Auto-save completed")
    
