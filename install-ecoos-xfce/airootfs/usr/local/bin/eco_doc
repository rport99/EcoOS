    # Repair Actions
    def reinstall_grub(self):
        if self.confirm_action("Reinstall GRUB", "Reinstall GRUB bootloader?"):
            backup_files = ["/boot/grub/grub.cfg", "/etc/default/grub"]
            self.worker.add_command("sudo grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB", "Reinstall GRUB", backup_files=backup_files)
            self.worker.add_command("sudo grub-mkconfig -o /boot/grub/grub.cfg", "Update GRUB Config")
    
    def update_grub_config(self):
