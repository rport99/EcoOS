    # Printer Actions
    def install_printer_drivers(self):
        brand_map = {
            0: "hplip python-pyqt5",
            1: "epson-inkjet-printer-escpr",
            2: "brother",
            3: "cnijfilter2",
            4: "cups cups-filters",
            5: "splix"
        }
        
        brand_id = self.printer_brand.checkedId()
        packages = brand_map.get(brand_id, brand_map[4])
        
        backup_files = ["/etc/cups/cupsd.conf"]
        self.worker.add_command(f"sudo pacman -S --noconfirm {packages} cups", f"Install {self.printer_brand.checkedButton().text()} Drivers", backup_files=backup_files)
        self.worker.add_command("sudo systemctl enable --now cups.service", "Enable CUPS")
    
    def detect_printers(self):
        self.worker.add_command("lpstat -p", "Detect Printers")
        self.worker.add_command("lpinfo -v", "Printer Info")
    
    def start_cups(self):
        self.worker.add_command("sudo systemctl start cups.service", "Start CUPS")
    
    def stop_cups(self):
        self.worker.add_command("sudo systemctl stop cups.service", "Stop CUPS")
    
    def check_printer_status(self):
        self.worker.add_command("systemctl status cups.service", "CUPS Status")
        self.worker.add_command("lpstat -t", "Print Queue")
    
    def test_print(self):
        self.worker.add_command("echo 'Test Print from EcoOS Doctor' | lp", "Test Print")
    
    def clean_print_queue(self):
