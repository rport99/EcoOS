            backup_files = ["/etc/pacman.conf", "/etc/pacman.d/mirrorlist"]
            self.worker.add_command("sudo pacman -Syy --force", "Force Sync", backup_files=backup_files)
    
    # Network Actions
    def refresh_network_status(self):
        self.worker.add_command("ip addr show", "Network Interfaces")
        self.worker.add_command("nmcli device status", "Network Status")
        self.worker.add_command("ping -c 1 archlinux.org", "Test Connectivity")
    
    def restart_networkmanager(self):
        backup_files = ["/etc/NetworkManager/NetworkManager.conf"]
        self.worker.add_command("sudo systemctl restart NetworkManager", "Restart NetworkManager", backup_files=backup_files)
    
    def reset_networkmanager_config(self):
        if self.confirm_action("Reset NetworkManager", "Reset NetworkManager configuration?"):
            backup_files = ["/etc/NetworkManager/NetworkManager.conf", "/etc/NetworkManager/system-connections/*"]
            self.worker.add_command("sudo systemctl stop NetworkManager", "Stop NetworkManager")
            self.worker.add_command("sudo rm -rf /etc/NetworkManager/system-connections/*", "Remove Connections")
            self.worker.add_command("sudo systemctl start NetworkManager", "Start NetworkManager")
    
    def fix_dns(self):
        backup_files = ["/etc/resolv.conf"]
        self.worker.add_command("sudo systemctl restart systemd-resolved", "Fix DNS", backup_files=backup_files)
    
    def install_wifi_drivers(self):
        self.worker.add_command("sudo pacman -S --noconfirm linux-firmware iw wpa_supplicant", "Install WiFi")
    
    def setup_bluetooth(self):
        backup_files = ["/etc/bluetooth/main.conf"]
        self.worker.add_command("sudo pacman -S --noconfirm bluez bluez-utils", "Install Bluetooth", backup_files=backup_files)
        self.worker.add_command("sudo systemctl enable --now bluetooth", "Enable Bluetooth")
    
    def check_connectivity(self):
        self.worker.add_command("ping -c 3 archlinux.org", "Check Connectivity")
    
    def flush_dns(self):
        backup_files = ["/etc/resolv.conf"]
        self.worker.add_command("sudo systemd-resolve --flush-caches", "Flush DNS", backup_files=backup_files)
    
    def view_network_connections(self):
        self.worker.add_command("nmcli connection show", "Network Connections")
    
    def set_dns(self, dns_server):
        if self.confirm_action("Set DNS", f"Set DNS server to {dns_server}?"):
            backup_files = ["/etc/resolv.conf"]
            self.worker.add_command(f"echo 'nameserver {dns_server}' | sudo tee /etc/resolv.conf", f"Set DNS {dns_server}", backup_files=backup_files)
    
    def set_custom_dns(self):
        dns_server = self.custom_dns.text().strip()
        if dns_server:
            self.set_dns(dns_server)
    
    # Log Actions
    def view_log(self, command):
        self.worker.add_command(command, "View Log")
    
    def save_log(self):
        filename, _ = QFileDialog.getSaveFileName(
            self, "Save Log", "", "Text Files (*.txt);;All Files (*)"
        )
        if filename:
            try:
                with open(filename, 'w') as f:
                    f.write(self.log_viewer.toPlainText())
                self.append_output("success", "Save Log", f"Log saved to {filename}")
            except Exception as e:
                self.append_output("error", "Save Log", f"Failed: {str(e)}")
    
    def copy_log_to_clipboard(self):
        clipboard = QApplication.clipboard()
        clipboard.setText(self.log_viewer.toPlainText())
        self.append_output("success", "Clipboard", "Log copied to clipboard")
    
    def closeEvent(self, event):
        """Cleanup on close"""
        self.worker.stop()
        event.accept()

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("EcoOS System Doctor")
    app.setApplicationDisplayName("EcoOS System Doctor - Intelligent Edition")
    
    window = EcoOSDoctor()
    window.show()
    
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()