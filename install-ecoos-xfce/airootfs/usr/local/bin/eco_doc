    def view_printer_logs(self):
        self.worker.add_command("journalctl -u cups -n 50", "CUPS Logs")
    
    # Driver Actions
    def detect_gpu(self):
        try:
            result = subprocess.run("lspci | grep -E 'VGA|3D|Display'", shell=True, capture_output=True, text=True)
            if result.stdout:
                gpus = result.stdout.strip().split('\n')
                info = "Detected GPUs:\n"
                for gpu in gpus[:3]:  # Show first 3
                    info += f"• {gpu.split(': ')[-1]}\n"
                self.gpu_info.setText(info)
            else:
                self.gpu_info.setText("No GPU detected")
        except Exception as e:
            self.gpu_info.setText(f"Error: {str(e)}")
    
    def install_nvidia_drivers(self):
        backup_files = ["/etc/X11/xorg.conf", "/etc/modprobe.d/nvidia.conf"]
        self.worker.add_command("sudo pacman -S --noconfirm nvidia nvidia-utils nvidia-settings", "Install NVIDIA", backup_files=backup_files)
        self.worker.add_command("sudo mkinitcpio -P", "Rebuild Initramfs")
    
    def install_nouveau_drivers(self):
