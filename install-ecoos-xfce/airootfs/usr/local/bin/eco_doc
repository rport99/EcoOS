# --- Enhanced Theme System with Light/Dark Mode ---
class ThemeMode(Enum):
    DARK = "dark"
    LIGHT = "light"
    AUTO = "auto"

class ThemeManager:
    """Manages application themes with light/dark mode support"""
    
    def __init__(self):
        self.settings = QSettings("EcoOS", "SystemDoctor")
        self.current_mode = ThemeMode(self.settings.value("theme_mode", ThemeMode.DARK.value))
        
        # Dark theme colors (Tokyo Night)
        self.dark_theme = {
            # Primary Colors
            "bg": "#1a1b26",
            "fg": "#c0caf5",
            "accent": "#7aa2f7",
            "secondary": "#414868",
            "surface": "#24283b",
            
            # Status Colors
            "success": "#9ece6a",
            "warning": "#e0af68",
            "error": "#f7768e",
            "info": "#7dcfff",
            
            # Fonts
            "font_family": "JetBrains Mono, Noto Sans, sans-serif",
            "font_size": "10pt"
        }
        
        # Light theme colors
        self.light_theme = {
            # Primary Colors
            "bg": "#f5f5f5",
            "fg": "#24283b",
            "accent": "#3d59a1",
            "secondary": "#d0d0d0",
            "surface": "#ffffff",
            
            # Status Colors
            "success": "#5c8e2e",
            "warning": "#b07e0d",
            "error": "#d32f2f",
            "info": "#0288d1",
            
            # Fonts
            "font_family": "JetBrains Mono, Noto Sans, sans-serif",
            "font_size": "10pt"
        }
        
        # Apply appropriate theme based on mode
        if self.current_mode == ThemeMode.AUTO:
            # Detect system theme (simplified)
            self.is_dark = True  # Default to dark for now
        else:
            self.is_dark = (self.current_mode == ThemeMode.DARK)
            
        self.theme = self.dark_theme if self.is_dark else self.light_theme
    
    def get_color(self, name: str) -> str:
        """Get a color value by name from the current theme"""
        return self.theme.get(name, "#000000")
    
    def set_theme_mode(self, mode: ThemeMode):
        """Set the theme mode and save to settings"""
        self.current_mode = mode
        self.settings.setValue("theme_mode", mode.value)
        
        if mode == ThemeMode.AUTO:
            # Detect system theme (simplified)
            self.is_dark = True  # Default to dark for now
        else:
            self.is_dark = (mode == ThemeMode.DARK)
            
        self.theme = self.dark_theme if self.is_dark else self.light_theme
        return self.theme
    
    def apply_theme(self, app):
        """Applies the current theme to the entire application."""
        theme = self.theme
        palette = QPalette()
        palette.setColor(QPalette.Window, QColor(theme["bg"]))
        palette.setColor(QPalette.WindowText, QColor(theme["fg"]))
        palette.setColor(QPalette.Base, QColor(theme["surface"]))
        palette.setColor(QPalette.AlternateBase, QColor(theme["secondary"]))
        palette.setColor(QPalette.ToolTipBase, QColor(theme["bg"]))
        palette.setColor(QPalette.ToolTipText, QColor(theme["fg"]))
        palette.setColor(QPalette.Text, QColor(theme["fg"]))
        palette.setColor(QPalette.Button, QColor(theme["accent"]))
        palette.setColor(QPalette.ButtonText, QColor(theme["bg"]))
        palette.setColor(QPalette.BrightText, QColor(theme["error"]))
        palette.setColor(QPalette.Link, QColor(theme["accent"]))
        palette.setColor(QPalette.Highlight, QColor(theme["accent"]))
        palette.setColor(QPalette.HighlightedText, QColor(theme["bg"]))
        app.setPalette(palette)
        
        app.setStyleSheet(f"""
            QWidget {{
                font-family: {theme["font_family"]};
                font-size: {theme["font_size"]};
                color: {theme["fg"]};
                background-color: {theme["bg"]};
