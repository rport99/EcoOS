    # ===== Utility Methods =====
    
    def get_root_usage(self):
        """Get root partition usage"""
        try:
            result = subprocess.run(['df', '-h', '/'], capture_output=True, text=True)
            if result.returncode == 0:
                lines = result.stdout.strip().split('\n')
                if len(lines) > 1:
                    parts = lines[1].split()
                    if len(parts) >= 5:
                        return f"{parts[4]} used ({parts[3]} free)"
        except:
            pass
        return "Unknown"
    
    def get_home_usage(self):
        """Get home partition usage"""
        try:
            result = subprocess.run(['df', '-h', '/home'], capture_output=True, text=True)
            if result.returncode == 0:
                lines = result.stdout.strip().split('\n')
                if len(lines) > 1:
                    parts = lines[1].split()
                    if len(parts) >= 5:
                        return f"{parts[4]} used ({parts[3]} free)"
        except:
            pass
        return "Unknown"
    
    def check_privileges(self):
        """Check if running with sufficient privileges"""
        if os.geteuid() != 0:
            self.append_output("warning", "Privileges", 
                "Warning: Running without root privileges. Some features may not work.\n"
                "Run with 'sudo' for full functionality.")
    
    def append_output(self, msg_type, title, message):
        """Append formatted output to console"""
        colors = {
            "info": self.theme_manager.get_color("info"),
            "error": self.theme_manager.get_color("error"),
            "warning": self.theme_manager.get_color("warning"),
            "success": self.theme_manager.get_color("success"),
            "output": self.theme_manager.get_color("fg")
        }
        
        color = colors.get(msg_type, self.theme_manager.get_color("fg"))
        formatted = f'<span style="color: {color};"><b>{title}:</b> {message}</span>'
        
        self.console_output.append(formatted)
        self.console_output.moveCursor(QTextCursor.End)
        
        # Update status bar
        self.status_bar.showMessage(f"Last action: {title}", 3000)
    
    def command_finished(self, title, success):
        """Handle command completion"""
        if success:
            self.append_output("success", title, "✓ Completed successfully")
        else:
            self.append_output("error", title, "✗ Failed")
    
    def update_progress(self, current, total, message):
        """Update progress bar"""
        if total > 0:
            self.progress_bar.setVisible(True)
            self.progress_bar.setMaximum(total)
            self.progress_bar.setValue(current)
            self.progress_bar.setFormat(f"{message} ({current}/{total})")
            
            if current >= total:
                QTimer.singleShot(1000, lambda: self.progress_bar.setVisible(False))
    
    def handle_backup_needed(self, operation, description, files):
        """Handle backup notification"""
        self.append_output("info", "Backup", f"Creating backup before {operation}")
    
    def clear_console(self):
        """Clear console output"""
        self.console_output.clear()
    
    def toggle_backups(self, state):
        """Toggle automatic backup creation"""
        self.worker.create_backups = (state == Qt.Checked)
    
    def confirm_action(self, title, message):
        """Show confirmation dialog"""
        reply = QMessageBox.question(
            self, title, message,
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No
        )
        return reply == QMessageBox.Yes
    
    def switch_theme(self, mode):
        """Switch application theme"""
        self.theme_manager.set_theme_mode(mode)
        self.theme_manager.apply_theme(QApplication.instance())
    
    def change_theme(self, theme_text):
        """Handle theme change from combo box"""
        mode_map = {
            "Dark": ThemeMode.DARK,
            "Light": ThemeMode.LIGHT,
            "Auto": ThemeMode.AUTO
        }
        mode = mode_map.get(theme_text, ThemeMode.DARK)
        self.switch_theme(mode)
    
    def change_log_level(self, level_text):
        """Change logging level"""
        level_map = {
            "DEBUG": logging.DEBUG,
            "INFO": logging.INFO,
            "WARNING": logging.WARNING,
            "ERROR": logging.ERROR,
            "CRITICAL": logging.CRITICAL
        }
        level = level_map.get(level_text, logging.INFO)
        logger.setLevel(level)
    
    def save_settings(self):
        """Save application settings"""
        # Save theme setting
        self.theme_manager.settings.setValue("theme_mode", self.theme_manager.current_mode.value)
        
        # Save other settings
        self.theme_manager.settings.setValue("auto_backup", self.auto_backup_checkbox.isChecked())
        self.theme_manager.settings.setValue("perf_monitor", self.perf_monitor_checkbox.isChecked())
        self.theme_manager.settings.setValue("command_timeout", self.timeout_spin.value())
        self.theme_manager.settings.setValue("log_level", self.log_combo.currentText())
        
        self.theme_manager.settings.sync()
        self.append_output("success", "Settings", "Settings saved successfully")
    
    # ===== System Check Methods =====
    
    def run_initial_checks(self):
        """Run initial system checks"""
        self.append_output("info", "System Check", "Starting initial system health check...")
        
        checks = [
            ("Update Check", "checkupdates 2>/dev/null | wc -l"),
            ("Orphan Check", "pacman -Qtdq 2>/dev/null | wc -l"),
            ("Keyring Check", "pacman -Q archlinux-keyring 2>/dev/null && echo 'OK' || echo 'MISSING'"),
            ("Network Check", "ping -c 1 -W 2 archlinux.org >/dev/null 2>&1 && echo 'CONNECTED' || echo 'DISCONNECTED'")
        ]
        
        for title, cmd in checks:
            try:
                result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
                output = result.stdout.strip()
                self.append_output("info", title, output)
            except Exception as e:
                self.append_output("error", title, f"Check failed: {str(e)}")
    
    def run_system_check(self):
        """Run comprehensive system check"""
        # Clear existing issues
        for i in reversed(range(self.issues_layout.count())):
            child = self.issues_layout.itemAt(i).widget()
            if child:
                child.setParent(None)
        
        # Get system info
        self.system_info = SystemInfoCollector.get_all()
        
        # Find issues using knowledge base
        issues = self.knowledge_base.find_issues(self.system_info)
        
        # Display issues
        for issue in issues:
            issue_widget = IssueWidget(issue)
            issue_widget.fix_requested.connect(self.fix_issue)
            self.issues_layout.insertWidget(self.issues_layout.count() - 1, issue_widget)
    
    def update_health_score(self):
        """Update system health score"""
        # Calculate health score based on various factors
        score = 100
        
        # Deduct points for issues
        if self.system_info.updates_available > 0:
            score -= min(10, self.system_info.updates_available)
        
        if self.system_info.orphaned_packages > 0:
            score -= min(10, self.system_info.orphaned_packages)
        
        if self.system_info.disk_percent > 80:
            score -= min(20, self.system_info.disk_percent - 80)
        
        if self.system_info.network_status != "Connected":
            score -= 15
        
        if self.system_info.ram_percent > 90:
            score -= 15
        
        # Update display
        self.health_score_label.setText(f"{score}/100")
        
        # Set color based on score
        if score >= 80:
            color = self.theme_manager.get_color("success")
        elif score >= 60:
            color = self.theme_manager.get_color("warning")
        else:
            color = self.theme_manager.get_color("error")
        
        self.health_score_label.setStyleSheet(f"font-size: 24pt; font-weight: bold; color: {color};")
        
        # Update progress bar
        self.health_score_bar.setValue(score)
        
        # Set color for progress bar
        self.health_score_bar.setStyleSheet(f"""
            QProgressBar::chunk {{
                background-color: {color};
                border-radius: 6px;
            }}
        """)
        
        # Update health factors
        self.health_factors.clear()
        
        factors = [
            f"Updates Available: {self.system_info.updates_available}",
            f"Orphaned Packages: {self.system_info.orphaned_packages}",
            f"Disk Usage: {self.system_info.disk_percent}%",
            f"Network Status: {self.system_info.network_status}",
            f"Memory Usage: {self.system_info.ram_percent}%"
        ]
        
        for factor in factors:
            self.health_factors.addItem(factor)
    
    def generate_recommendations(self):
        """Generate smart recommendations based on system state"""
        self.recommendations.clear()
        
        # Update recommendations based on system info
        if self.system_info.updates_available > 0:
            self.recommendations.addItem(f"Install {self.system_info.updates_available} system updates")
        
        if self.system_info.orphaned_packages > 0:
            self.recommendations.addItem(f"Remove {self.system_info.orphaned_packages} orphaned packages")
        
        if self.system_info.disk_percent > 80:
            self.recommendations.addItem("Clean package cache and old logs to free disk space")
        
        if self.system_info.network_status != "Connected":
            self.recommendations.addItem("Check network configuration and restart NetworkManager")
        
        if self.system_info.ram_percent > 90:
            self.recommendations.addItem("Close unnecessary applications to free memory")
        
        # Add GPU-specific recommendations
        if "NVIDIA" in self.system_info.gpu:
            self.recommendations.addItem("Install NVIDIA proprietary drivers for better performance")
        elif "AMD" in self.system_info.gpu:
            self.recommendations.addItem("Install AMD drivers for optimal graphics performance")
        elif "Intel" in self.system_info.gpu:
            self.recommendations.addItem("Install Intel drivers for optimal graphics performance")
    
    def update_performance(self):
        """Update performance monitoring displays"""
        if not self.perf_monitor_checkbox.isChecked():
            return
        
        try:
            # CPU usage
            cpu_percent = psutil.cpu_percent(interval=0.1)
            self.cpu_usage_bar.setValue(int(cpu_percent))
            
            # Memory usage
            mem = psutil.virtual_memory()
            self.mem_usage_bar.setValue(int(mem.percent))
            
            # Disk usage
            disk = psutil.disk_usage('/')
            self.disk_usage_bar.setValue(int(disk.percent))
        except Exception as e:
            logger.error(f"Error updating performance metrics: {e}")
    
    def refresh_system_info(self):
        """Refresh system information"""
        self.system_info = SystemInfoCollector.get_all()
        self.append_output("success", "System Info", "System information refreshed")
    
    def fix_issue(self, issue_title):
        """Fix a specific issue"""
        issue = self.knowledge_base.get_issue_by_title(issue_title)
        if issue and issue.auto_fixable and issue.fix_command:
            if self.confirm_action("Fix Issue", f"Fix issue: {issue_title}?"):
                self.worker.add_command(issue.fix_command, f"Fix: {issue_title}")
    
    # ===== Backup Methods =====
    
    def create_backup(self):
        """Create a system backup"""
        description = self.backup_desc.text() or f"Backup created on {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
        backup_type = self.backup_type.currentText()
        
        # Get selected files
        selected_files = []
        for i in range(self.backup_files.count()):
            item = self.backup_files.item(i)
            if item.isSelected():
                selected_files.append(item.text())
        
        if not selected_files:
            self.append_output("error", "Backup", "No files selected for backup")
            return
        
        # Create backup
        try:
            backup_info = self.backup_manager.create_backup(description, backup_type, selected_files)
            self.append_output("success", "Backup", f"Created backup: {backup_info.timestamp}")
            self.refresh_backups()
        except Exception as e:
            self.append_output("error", "Backup", f"Failed to create backup: {str(e)}")
    
    def refresh_backups(self):
        """Refresh the backups list"""
        self.backups_list.clear()
        
        for backup in self.backup_manager.backups:
            item_text = f"{backup.timestamp} - {backup.description} ({backup.backup_type})"
            self.backups_list.addItem(item_text)
    
    # ===== Action Methods =====
    
    # Dashboard Actions
    def update_system(self):
