        self.worker.add_command("sudo systemctl enable --now bluetooth", "Enable Bluetooth")
    
    def fix_system_permissions(self):
        if self.confirm_action("Fix Permissions", "Fix system permissions?"):
            backup_files = ["/etc/passwd", "/etc/group", "/etc/shadow"]
            self.worker.add_command("sudo chmod 755 /", "Fix Root Permissions", backup_files=backup_files)
            self.worker.add_command("sudo chown -R root:root /etc", "Fix Config Permissions")
    
    def repair_locale(self):
