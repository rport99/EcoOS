            backup_files = ["/boot/grub/grub.cfg", "/etc/mkinitcpio.conf"]
            self.worker.add_command("sudo pacman -S linux linux-headers --force", "Reinstall Kernel", backup_files=backup_files)
    
    def reset_xfce(self):
        if self.confirm_action("Reset XFCE", "Reset XFCE configuration?"):
            backup_files = ["~/.config/xfce4"]
            self.worker.add_command("cp -r ~/.config/xfce4 ~/.config/xfce4.backup.$(date +%s)", "Backup XFCE", backup_files=backup_files)
            self.worker.add_command("rm -rf ~/.config/xfce4", "Reset XFCE")
    
    def remove_all_orphans(self):
        if self.confirm_action("Remove All Orphans", "Remove all orphan packages (forceful)?"):
            self.worker.add_command("sudo pacman -Rns $(pacman -Qtdq) 2>/dev/null || echo 'No orphans'", "Remove Orphans")
    
    def force_pacman_sync(self):
