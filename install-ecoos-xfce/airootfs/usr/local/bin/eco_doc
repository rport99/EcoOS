        self.setGeometry(100, 100, 1200, 800)
        
        # Initialize components
        self.theme_manager = ThemeManager()
        self.system_info = SystemInfoCollector.get_all()
        self.knowledge_base = KnowledgeBase()
        self.backup_manager = BackupManager()
        self.worker = CommandWorker()
        
        # Connect signals
        self.worker.output_signal.connect(self.append_output)
        self.worker.finished_signal.connect(self.command_finished)
        self.worker.progress_signal.connect(self.update_progress)
        self.worker.backup_needed_signal.connect(self.handle_backup_needed)
        
        # Setup UI
        self.init_ui()
        self.theme_manager.apply_theme(QApplication.instance())
        
        # Check privileges
        self.check_privileges()
        
        # Run initial checks after UI is ready
        QTimer.singleShot(1000, self.run_initial_checks)
    
