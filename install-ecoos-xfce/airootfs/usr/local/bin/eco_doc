# --- Data Models for System Information ---
@dataclass
class SystemInfo:
    """Data class for system information"""
    hostname: str = "Unknown"
    kernel: str = "Unknown"
    uptime: str = "Unknown"
    cpu: str = "Unknown"
    gpu: str = "Unknown"
    ram_total: str = "Unknown"
    ram_used: str = "Unknown"
    ram_percent: float = 0
    disk_total: str = "Unknown"
    disk_used: str = "Unknown"
    disk_percent: float = 0
    updates_available: int = 0
    orphaned_packages: int = 0
    network_status: str = "Unknown"
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary for JSON serialization"""
        return asdict(self)
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'SystemInfo':
        """Create from dictionary"""
        return cls(**data)

@dataclass
class IssueInfo:
    """Data class for system issues"""
    severity: str  # "low", "medium", "high", "critical"
    category: str  # "system", "network", "packages", "hardware", etc.
    title: str
    description: str
    solution: str
    auto_fixable: bool = False
    fix_command: Optional[str] = None
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary for JSON serialization"""
        return asdict(self)
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'IssueInfo':
        """Create from dictionary"""
        return cls(**data)

@dataclass
class BackupInfo:
    """Data class for backup information"""
    timestamp: str
    description: str
    backup_type: str  # "full", "config", "registry", etc.
    files: List[str]
    checksum: str
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary for JSON serialization"""
        return asdict(self)
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'BackupInfo':
        """Create from dictionary"""
        return cls(**data)

# --- Knowledge Base for Common Issues ---
class KnowledgeBase:
    """Knowledge base for common system issues and their solutions"""
    
    def __init__(self):
        self.issues_db = [
            IssueInfo(
                severity="medium",
                category="packages",
                title="System updates available",
                description="There are system packages that need to be updated.",
                solution="Run system update: pacman -Syu",
                auto_fixable=True,
                fix_command="sudo pacman -Syu --noconfirm"
            ),
            IssueInfo(
                severity="low",
                category="packages",
                title="Orphaned packages found",
                description="There are packages installed as dependencies that are no longer required.",
                solution="Remove orphaned packages: pacman -Rns $(pacman -Qtdq)",
                auto_fixable=True,
                fix_command="sudo pacman -Rns $(pacman -Qtdq) --noconfirm"
            ),
            IssueInfo(
                severity="high",
                category="storage",
                title="Low disk space",
                description="Root partition is running low on disk space.",
                solution="Clean package cache: pacman -Scc, remove old logs: journalctl --vacuum-time=7d",
                auto_fixable=True,
                fix_command="sudo pacman -Scc --noconfirm && sudo journalctl --vacuum-time=7d"
            ),
            IssueInfo(
                severity="medium",
                category="network",
                title="No internet connection",
                description="System cannot connect to the internet.",
                solution="Check network configuration and restart NetworkManager: systemctl restart NetworkManager",
                auto_fixable=True,
                fix_command="sudo systemctl restart NetworkManager"
            ),
            IssueInfo(
                severity="medium",
                category="hardware",
                title="Graphics driver issues",
                description="Graphics drivers may not be properly installed or configured.",
                solution="Install appropriate graphics drivers for your hardware.",
                auto_fixable=False
            ),
            IssueInfo(
                severity="low",
                category="system",
                title="High memory usage",
                description="System is using a high amount of RAM.",
                solution="Check for memory leaks in applications and consider closing unused programs.",
                auto_fixable=False
            ),
            IssueInfo(
                severity="critical",
                category="boot",
                title="Boot configuration issues",
                description="There may be problems with the bootloader configuration.",
                solution="Update GRUB configuration: grub-mkconfig -o /boot/grub/grub.cfg",
                auto_fixable=True,
                fix_command="sudo grub-mkconfig -o /boot/grub/grub.cfg"
            ),
            IssueInfo(
                severity="medium",
                category="audio",
                title="Audio not working",
                description="Audio system may not be properly configured.",
                solution="Restart PulseAudio: pulseaudio -k && pulseaudio --start",
                auto_fixable=True,
                fix_command="pulseaudio -k && pulseaudio --start"
            )
        ]
    
    def find_issues(self, system_info: SystemInfo) -> List[IssueInfo]:
        """Find issues based on system information"""
        issues = []
        
        # Check for updates
        if system_info.updates_available > 0:
            issue = self.issues_db[0]  # Updates available
            issues.append(issue)
        
        # Check for orphaned packages
        if system_info.orphaned_packages > 0:
            issue = self.issues_db[1]  # Orphaned packages
            issues.append(issue)
        
        # Check disk space
        if system_info.disk_percent > 90:
            issue = self.issues_db[2]  # Low disk space
            issues.append(issue)
        
        # Check network
        if system_info.network_status != "Connected":
            issue = self.issues_db[3]  # No internet connection
            issues.append(issue)
        
        # Check memory usage
        if system_info.ram_percent > 90:
            issue = self.issues_db[5]  # High memory usage
            issues.append(issue)
        
        return issues
    
    def get_issue_by_title(self, title: str) -> Optional[IssueInfo]:
        """Get an issue by its title"""
        for issue in self.issues_db:
            if issue.title == title:
                return issue
        return None

# --- Backup and Restore System ---
class BackupManager:
    """Manages system backups and restoration"""
    
    def __init__(self):
        self.backup_dir = Path.home() / ".ecosos_doctor" / "backups"
        self.backup_dir.mkdir(parents=True, exist_ok=True)
        self.backups_file = self.backup_dir / "backups.json"
        self.backups = self.load_backups()
    
    def load_backups(self) -> List[BackupInfo]:
        """Load backup information from file"""
        if not self.backups_file.exists():
            return []
        
        try:
            with open(self.backups_file, 'r') as f:
                backups_data = json.load(f)
                return [BackupInfo.from_dict(data) for data in backups_data]
        except Exception as e:
            logger.error(f"Error loading backups: {e}")
            return []
    
    def save_backups(self):
        """Save backup information to file"""
        try:
            with open(self.backups_file, 'w') as f:
                backups_data = [backup.to_dict() for backup in self.backups]
                json.dump(backups_data, f, indent=2)
        except Exception as e:
            logger.error(f"Error saving backups: {e}")
    
    def create_backup(self, description: str, backup_type: str, files: List[str]) -> BackupInfo:
        """Create a backup of specified files"""
        timestamp = datetime.datetime.now().isoformat()
        backup_id = hashlib.md5(f"{timestamp}{description}".encode()).hexdigest()[:8]
        backup_path = self.backup_dir / f"backup_{backup_id}"
        backup_path.mkdir(exist_ok=True)
        
        # Copy files to backup directory
        backed_up_files = []
        for file_path in files:
            try:
                src = Path(file_path)
                if src.exists():
                    dst = backup_path / src.name
                    if src.is_dir():
                        subprocess.run(["cp", "-r", str(src), str(dst)], check=True)
                    else:
                        subprocess.run(["cp", str(src), str(dst)], check=True)
                    backed_up_files.append(str(dst))
                    logger.info(f"Backed up: {file_path} -> {dst}")
            except Exception as e:
                logger.error(f"Error backing up {file_path}: {e}")
        
        # Calculate checksum of all backed up files
        checksum = self.calculate_checksum(backup_path)
        
        # Create backup info
        backup_info = BackupInfo(
            timestamp=timestamp,
            description=description,
            backup_type=backup_type,
            files=backed_up_files,
            checksum=checksum
        )
        
        # Add to backups list and save
        self.backups.append(backup_info)
        self.save_backups()
        
        return backup_info
    
    def restore_backup(self, backup_info: BackupInfo) -> bool:
        """Restore files from a backup"""
        try:
            # Verify checksum
            backup_id = backup_info.files[0].split('/')[-2].split('_')[-1]
            backup_path = self.backup_dir / f"backup_{backup_id}"
            
            if not backup_path.exists():
                logger.error(f"Backup directory not found: {backup_path}")
                return False
            
            current_checksum = self.calculate_checksum(backup_path)
            if current_checksum != backup_info.checksum:
                logger.error("Backup checksum mismatch - backup may be corrupted")
                return False
            
            # Restore files
            for file_path in backup_info.files:
                src = Path(file_path)
                if src.exists():
                    # Determine original path
                    if "xfce4" in str(src):
                        dst = Path.home() / ".config" / src.name
                    elif "grub.cfg" in str(src):
                        dst = Path("/boot/grub/grub.cfg")
                    else:
                        # Default to original location
                        dst = Path(file_path.replace(str(backup_path), ""))
                    
                    # Create parent directories if needed
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    
                    # Copy file back
                    if src.is_dir():
                        subprocess.run(["cp", "-r", str(src), str(dst)], check=True)
                    else:
                        subprocess.run(["cp", str(src), str(dst)], check=True)
                    
                    logger.info(f"Restored: {src} -> {dst}")
            
            return True
        except Exception as e:
            logger.error(f"Error restoring backup: {e}")
            return False
    
    def calculate_checksum(self, directory: Path) -> str:
        """Calculate checksum of all files in a directory"""
        hash_md5 = hashlib.md5()
        for root, _, files in os.walk(directory):
            for file in sorted(files):
                file_path = os.path.join(root, file)
                with open(file_path, "rb") as f:
                    for chunk in iter(lambda: f.read(4096), b""):
                        hash_md5.update(chunk)
        return hash_md5.hexdigest()
    
    def delete_backup(self, backup_info: BackupInfo) -> bool:
        """Delete a backup"""
        try:
            backup_id = backup_info.files[0].split('/')[-2].split('_')[-1]
            backup_path = self.backup_dir / f"backup_{backup_id}"
            
            if backup_path.exists():
                subprocess.run(["rm", "-rf", str(backup_path)], check=True)
            
            # Remove from backups list
            self.backups = [b for b in self.backups if b.timestamp != backup_info.timestamp]
            self.save_backups()
            
            return True
        except Exception as e:
            logger.error(f"Error deleting backup: {e}")
            return False

# --- Enhanced Command Worker with Progress Tracking ---
class CommandWorker(QThread):
    """Enhanced worker thread for running system commands safely with better progress tracking"""
    output_signal = pyqtSignal(str, str, str)  # type, title, message
    finished_signal = pyqtSignal(str, bool)  # title, success
    progress_signal = pyqtSignal(int, int, str)  # current, total, message
    backup_needed_signal = pyqtSignal(str, str, list)  # operation, description, files
    
    def __init__(self):
        super().__init__()
        self.commands = []
        self.running = True
        self.current_command = 0
        self.backup_manager = BackupManager()
        self.create_backups = True
        
    def add_command(self, cmd, desc="", shell=True, backup_files=None):
        """Add a command to the queue with optional backup files"""
        self.commands.append((cmd, desc, shell, backup_files or []))
        
    def run(self):
        total_commands = len(self.commands)
        self.current_command = 0
        
        while self.running and self.current_command < total_commands:
            cmd, desc, use_shell, backup_files = self.commands[self.current_command]
            
            # Create backup if needed and enabled
            if self.create_backups and backup_files:
                self.backup_needed_signal.emit(desc, f"Creating backup before {desc}", backup_files)
                backup_info = self.backup_manager.create_backup(
                    f"Before {desc}",
                    "auto",
                    backup_files
                )
                self.output_signal.emit("info", desc, f"Created backup: {backup_info.timestamp}")
            
            try:
                self.progress_signal.emit(self.current_command, total_commands, f"Executing: {desc}")
                self.output_signal.emit("info", desc, f"Executing: {cmd}\n{'='*50}")
                
                if use_shell:
                    process = subprocess.Popen(
                        cmd, 
                        shell=True, 
                        stdout=subprocess.PIPE, 
                        stderr=subprocess.PIPE,
                        text=True,
                        bufsize=1,
                        universal_newlines=True
                    )
                    
                    # Read output in real-time
                    stdout_lines = []
                    stderr_lines = []
                    
                    while True:
                        output = process.stdout.readline()
                        if output:
                            stdout_lines.append(output)
                            self.output_signal.emit("output", desc, output)
                        
                        error = process.stderr.readline()
                        if error:
                            stderr_lines.append(error)
                            self.output_signal.emit("error", desc, error)
                        
                        if output == '' and error == '' and process.poll() is not None:
                            break
                    
                    process.wait(timeout=300)  # 5 minute timeout
                    
                else:
                    # Non-shell execution for simple commands
                    result = subprocess.run(
                        shlex.split(cmd),
                        capture_output=True,
                        text=True,
                        timeout=60
                    )
                    
                    if result.stdout:
                        self.output_signal.emit("output", desc, result.stdout)
                    if result.stderr:
                        self.output_signal.emit("error", desc, result.stderr)
                    
                    stdout_lines = result.stdout.splitlines() if result.stdout else []
                    stderr_lines = result.stderr.splitlines() if result.stderr else []
                
                # Check for success
                success = (process.returncode == 0) if use_shell else (result.returncode == 0)
                
                if stderr_lines and not success:
                    self.output_signal.emit("error", desc, f"Command failed with return code: {process.returncode if use_shell else result.returncode}")
                
                self.finished_signal.emit(desc, success)
                
            except subprocess.TimeoutExpired:
                self.output_signal.emit("error", desc, "Command timed out after 5 minutes")
                self.finished_signal.emit(desc, False)
            except Exception as e:
                self.output_signal.emit("error", desc, f"Error executing command: {str(e)}")
                self.finished_signal.emit(desc, False)
            
            self.current_command += 1
            self.progress_signal.emit(self.current_command, total_commands, f"Completed: {desc}")
            
            if self.current_command < total_commands:
                time.sleep(0.5)  # Small delay between commands
    
    def stop(self):
        self.running = False
        self.wait(2000)  # Wait up to 2 seconds for thread to stop

# --- System Information Collector ---
class SystemInfoCollector:
    """Enhanced system information collector with better error handling"""
    
    @staticmethod
    def get_all() -> SystemInfo:
        """Collect all system information"""
        info = SystemInfo()
        
        try:
            # Basic system info
            info.hostname = subprocess.getoutput('hostname')
            
            # Kernel
            with open('/proc/version', 'r') as f:
                info.kernel = f.read().split()[2]
            
            # Uptime
            uptime_seconds = int(float(subprocess.getoutput('cat /proc/uptime').split()[0]))
            days = uptime_seconds // 86400
            hours = (uptime_seconds % 86400) // 3600
            minutes = (uptime_seconds % 3600) // 60
            info.uptime = f"{days}d {hours}h {minutes}m"
            
            # CPU
            with open('/proc/cpuinfo', 'r') as f:
                for line in f:
                    if 'model name' in line:
                        info.cpu = line.split(':', 1)[1].strip()
                        break
                else:
                    info.cpu = "Unknown"
            
            # RAM
            mem = psutil.virtual_memory()
            info.ram_total = f"{mem.total // (1024**3)} GB"
            info.ram_used = f"{mem.used // (1024**3)} GB"
            info.ram_percent = mem.percent
            
            # Disk
            disk = psutil.disk_usage('/')
            info.disk_total = f"{disk.total // (1024**3)} GB"
            info.disk_used = f"{disk.used // (1024**3)} GB"
            info.disk_percent = disk.percent
            
            # GPU detection
            try:
                gpu_info = subprocess.getoutput("lspci | grep -E 'VGA|3D|Display'")
                if gpu_info:
                    info.gpu = gpu_info.split('\n')[0].split(': ')[-1][:50] + "..."
                else:
                    info.gpu = "Not detected"
            except:
                info.gpu = "Unknown"
            
            # Check for updates
            try:
                result = subprocess.run("checkupdates 2>/dev/null | wc -l", shell=True, capture_output=True, text=True)
                info.updates_available = int(result.stdout.strip() or 0)
            except:
                info.updates_available = 0
            
            # Check for orphaned packages
            try:
                result = subprocess.run("pacman -Qtdq 2>/dev/null | wc -l", shell=True, capture_output=True, text=True)
                info.orphaned_packages = int(result.stdout.strip() or 0)
            except:
                info.orphaned_packages = 0
            
            # Check network status
            try:
                result = subprocess.run("ping -c 1 -W 2 archlinux.org >/dev/null 2>&1", shell=True)
                info.network_status = "Connected" if result.returncode == 0 else "Disconnected"
            except:
                info.network_status = "Unknown"
                
        except Exception as e:
            logger.error(f"Error collecting system info: {e}")
            
        return info

# --- Custom UI Components ---
class AnimatedButton(QPushButton):
    """Button with smooth hover animation"""
    def __init__(self, text, icon=None, parent=None):
        super().__init__(text, parent)
        self.setMinimumHeight(35)
        self.setCursor(Qt.PointingHandCursor)
        
        # Animation setup
        self._animation = QPropertyAnimation(self, b"geometry")
        self._animation.setDuration(150)
        self._animation.setEasingCurve(QEasingCurve.OutQuad)
        
        self._original_geometry = None
        
        if icon:
            self.setIcon(QIcon(icon))
    
    def enterEvent(self, event):
        if not self._original_geometry:
            self._original_geometry = self.geometry()
        
        # Create a slightly larger geometry for the animation
        new_geometry = QRect(
            self._original_geometry.x() - 2,
            self._original_geometry.y() - 2,
            self._original_geometry.width() + 4,
            self._original_geometry.height() + 4
        )
        
        self._animation.setStartValue(self._original_geometry)
        self._animation.setEndValue(new_geometry)
        self._animation.start()
        
        super().enterEvent(event)
    
    def leaveEvent(self, event):
        if self._original_geometry:
            self._animation.setStartValue(self.geometry())
            self._animation.setEndValue(self._original_geometry)
            self._animation.start()
        
        super().leaveEvent(event)

class StyledFrame(QFrame):
    """Custom styled frame with rounded corners"""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFrameStyle(QFrame.StyledPanel | QFrame.Raised)
        
    def update_style(self, theme_manager):
        """Update frame style based on current theme"""
        self.setStyleSheet(f"""
            QFrame {{
                background-color: {theme_manager.get_color("surface")};
                border: 1px solid {theme_manager.get_color("secondary")};
                border-radius: 8px;
                padding: 5px;
            }}
        """)

class IssueWidget(QWidget):
    """Widget for displaying system issues with fix buttons"""
    fix_requested = pyqtSignal(str)  # issue title
    
    def __init__(self, issue: IssueInfo, parent=None):
        super().__init__(parent)
        self.issue = issue
        self.init_ui()
    
    def init_ui(self):
        layout = QHBoxLayout(self)
        layout.setContentsMargins(5, 5, 5, 5)
        
        # Severity indicator
        severity_colors = {
            "low": "#9ece6a",
            "medium": "#e0af68",
            "high": "#f7768e",
            "critical": "#ff0000"
        }
        
        color = severity_colors.get(self.issue.severity, "#7aa2f7")
        indicator = QLabel()
        indicator.setFixedSize(10, 10)
        indicator.setStyleSheet(f"background-color: {color}; border-radius: 5px;")
        layout.addWidget(indicator)
        
        # Issue info
        info_layout = QVBoxLayout()
        info_layout.setSpacing(2)
        
        title = QLabel(self.issue.title)
        title.setStyleSheet("font-weight: bold;")
        info_layout.addWidget(title)
        
        desc = QLabel(self.issue.description)
        desc.setWordWrap(True)
        desc.setStyleSheet("font-size: 9pt; color: #c0caf5;")
        info_layout.addWidget(desc)
        
        layout.addLayout(info_layout)
        layout.addStretch()
        
        # Fix button if auto-fixable
        if self.issue.auto_fixable:
            fix_btn = AnimatedButton("Fix")
            fix_btn.clicked.connect(lambda: self.fix_requested.emit(self.issue.title))
            layout.addWidget(fix_btn)

class BackupWidget(QWidget):
    """Widget for displaying backup information with restore button"""
    restore_requested = pyqtSignal(BackupInfo)
    delete_requested = pyqtSignal(BackupInfo)
    
    def __init__(self, backup: BackupInfo, parent=None):
        super().__init__(parent)
        self.backup = backup
        self.init_ui()
    
    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(5, 5, 5, 5)
        
        # Backup info
        info_layout = QHBoxLayout()
        
        # Type indicator
        type_label = QLabel(self.backup.backup_type.upper())
        type_label.setStyleSheet(f"""
            background-color: #7aa2f7;
            color: #1a1b26;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 8pt;
        """)
        info_layout.addWidget(type_label)
        
        # Description
        desc_label = QLabel(self.backup.description)
        desc_label.setWordWrap(True)
        info_layout.addWidget(desc_label)
        
        layout.addLayout(info_layout)
        
        # Timestamp
        timestamp_label = QLabel(f"Created: {self.backup.timestamp}")
        timestamp_label.setStyleSheet("font-size: 8pt; color: #9aa5ce;")
        layout.addWidget(timestamp_label)
        
        # Buttons
        buttons_layout = QHBoxLayout()
        
        restore_btn = AnimatedButton("Restore")
        restore_btn.clicked.connect(lambda: self.restore_requested.emit(self.backup))
        buttons_layout.addWidget(restore_btn)
        
        delete_btn = AnimatedButton("Delete")
        delete_btn.clicked.connect(lambda: self.delete_requested.emit(self.backup))
        buttons_layout.addWidget(delete_btn)
        
        layout.addLayout(buttons_layout)

