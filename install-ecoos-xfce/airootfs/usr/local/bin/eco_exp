#!/usr/bin/env python3
"""
StormOS Expenses Calculator - Tokyo Night Theme (Simplified)
A clean, modern expense tracker without unnecessary dependencies
"""

import sys
import os
import re
import csv
import datetime
import locale
from decimal import Decimal, InvalidOperation
from typing import List, Tuple

# Minimal PyQt5 imports
from PyQt5.QtWidgets import (
    QApplication, QWidget, QLabel, QLineEdit, QPushButton,
    QHBoxLayout, QVBoxLayout, QMessageBox, QDesktopWidget,
    QShortcut, QGridLayout, QGroupBox
)
from PyQt5.QtGui import QKeySequence, QFont, QPalette, QColor
from PyQt5.QtCore import Qt

# ==============================================
# Tokyo Night Color Palette (Simplified)
# ==============================================
class TokyoNightColors:
    """Tokyo Night color palette"""
    BACKGROUND = "#1a1b26"
    SURFACE = "#24283b"
    SURFACE_DARK = "#1f2335"
    TEXT_PRIMARY = "#c0caf5"
    TEXT_SECONDARY = "#a9b1d6"
    ACCENT_BLUE = "#7aa2f7"
    ACCENT_GREEN = "#9ece6a"
    ACCENT_RED = "#f7768e"
    ACCENT_YELLOW = "#e0af68"
    ACCENT_CYAN = "#7dcfff"
    ACCENT_PURPLE = "#bb9af7"
    BORDER = "#414868"
    BORDER_LIGHT = "#565f89"

# ==============================================
# Main Application
# ==============================================
class ExpenseCalculator(QWidget):
    def __init__(self):
        super().__init__()
        
        # Initialize locale
        locale.setlocale(locale.LC_ALL, '')
        
        # Setup directories
        self.documents_dir = os.environ.get("XDG_DOCUMENTS_DIR", os.path.expanduser("~/Documents"))
        self.data_dir = os.path.join(self.documents_dir, "EcoOS_Expenses")
        os.makedirs(self.data_dir, exist_ok=True)
        self.csv_path = os.path.join(self.data_dir, "expenses.csv")
        
        # Initialize UI
        self.init_ui()
        self.apply_theme()
        self.center()
        
    def init_ui(self):
        """Initialize the user interface"""
        self.setWindowTitle('💰 EcoOS Expenses')
        self.setGeometry(100, 100, 600, 500)
        
        # Create main layout
        main_layout = QVBoxLayout()
        main_layout.setSpacing(15)
        main_layout.setContentsMargins(20, 20, 20, 20)
        
        # Header
        header = QLabel("🌙 EcoOS Expense Tracker")
        header_font = QFont("Segoe UI", 16, QFont.Bold)
        header.setFont(header_font)
        header.setAlignment(Qt.AlignCenter)
        header.setStyleSheet(f"color: {TokyoNightColors.ACCENT_CYAN}; margin-bottom: 10px;")
        
        # Input grid
        input_grid = QGridLayout()
        input_grid.setSpacing(10)
        
        # Expense categories
        categories = [
            ("Budget:", "budget_input", "e.g., 5000.00"),
            ("Mortgage/Rent:", "mortgage_input", "e.g., 1500.25"),
            ("Car 1:", "car1_input", "e.g., 500.00"),
            ("Car 2:", "car2_input", "e.g., 500.00"),
            ("Utilities:", "utilities_input", "e.g., 100.00"),
            ("Entertainment:", "entertainment_input", "e.g., 50.00"),
            ("Cell Phone:", "cell_phone_input", "e.g., 80.00")
        ]
        
        self.input_fields = {}
        for row, (label_text, field_name, placeholder) in enumerate(categories):
            # Label
            label = QLabel(label_text)
            label.setStyleSheet(f"color: {TokyoNightColors.TEXT_PRIMARY}; font-weight: 500;")
            
            # Input field
            input_field = QLineEdit()
            input_field.setPlaceholderText(placeholder)
            setattr(self, field_name, input_field)
            self.input_fields[field_name] = input_field
            
            input_grid.addWidget(label, row, 0)
            input_grid.addWidget(input_field, row, 1)
        
        # Summary section
        summary_group = QGroupBox("Summary")
        summary_group.setStyleSheet(f"""
            QGroupBox {{
                color: {TokyoNightColors.ACCENT_CYAN};
                font-weight: bold;
                border: 2px solid {TokyoNightColors.ACCENT_CYAN};
                border-radius: 8px;
                margin-top: 10px;
                padding-top: 15px;
            }}
        """)
        
        summary_layout = QGridLayout()
        summary_layout.setSpacing(10)
        
        # Create styled labels
        self.total_label = QLabel("Total Expenses:")
        self.total_display = QLabel("0.00")
        self.balance_label = QLabel("Balance:")
        self.balance_display = QLabel("0.00")
        
        # Style the summary labels
        for label in [self.total_label, self.balance_label]:
            label.setStyleSheet(f"color: {TokyoNightColors.TEXT_PRIMARY}; font-weight: 500; font-size: 13px;")
        
        summary_layout.addWidget(self.total_label, 0, 0)
        summary_layout.addWidget(self.total_display, 0, 1)
        summary_layout.addWidget(self.balance_label, 1, 0)
        summary_layout.addWidget(self.balance_display, 1, 1)
        summary_group.setLayout(summary_layout)
        
        # Buttons - each with different colors
        button_layout = QHBoxLayout()
        button_layout.setSpacing(10)
        
        # Calculate button (Blue)
        self.calc_button = QPushButton("🧮 Calculate")
        self.calc_button.setStyleSheet(f"""
            QPushButton {{
                background-color: {TokyoNightColors.ACCENT_BLUE};
                color: white;
                border: none;
                border-radius: 6px;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: #8ab4f8;
            }}
            QPushButton:pressed {{
                background-color: #5a8dee;
            }}
        """)
        
        # Save button (Green)
        self.add_button = QPushButton("💾 Save")
        self.add_button.setStyleSheet(f"""
            QPushButton {{
                background-color: {TokyoNightColors.ACCENT_GREEN};
                color: white;
                border: none;
                border-radius: 6px;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: #a3d977;
            }}
            QPushButton:pressed {{
                background-color: #8bb654;
            }}
        """)
        
        # Clear button (Yellow)
        self.clear_button = QPushButton("🗑️ Clear")
        self.clear_button.setStyleSheet(f"""
            QPushButton {{
                background-color: {TokyoNightColors.ACCENT_YELLOW};
                color: {TokyoNightColors.BACKGROUND};
                border: none;
                border-radius: 6px;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: #e8b96c;
            }}
            QPushButton:pressed {{
                background-color: #d19c52;
            }}
        """)
        
        # Quit button (Red)
        self.quit_button = QPushButton("🚪 Quit")
        self.quit_button.setStyleSheet(f"""
            QPushButton {{
                background-color: {TokyoNightColors.ACCENT_RED};
                color: white;
                border: none;
                border-radius: 6px;
                padding: 10px 20px;
                font-weight: bold;
                font-size: 13px;
            }}
            QPushButton:hover {{
                background-color: #f890a2;
            }}
            QPushButton:pressed {{
                background-color: #e35c74;
            }}
        """)
        
        button_layout.addWidget(self.calc_button)
        button_layout.addWidget(self.add_button)
        button_layout.addWidget(self.clear_button)
        button_layout.addWidget(self.quit_button)
        
        # Assemble main layout
        main_layout.addWidget(header)
        main_layout.addLayout(input_grid)
        main_layout.addWidget(summary_group)
        main_layout.addLayout(button_layout)
        
        self.setLayout(main_layout)
        
        # Connect signals
        self.calc_button.clicked.connect(self.calculate)
        self.add_button.clicked.connect(self.save_expenses)
        self.clear_button.clicked.connect(self.clear_all)
        self.quit_button.clicked.connect(self.close)
        
        # Keyboard shortcuts
        enter_shortcut = QShortcut(QKeySequence(Qt.Key_Return), self)
        enter_shortcut.activated.connect(self.calculate)
        enter_shortcut2 = QShortcut(QKeySequence(Qt.Key_Enter), self)
        enter_shortcut2.activated.connect(self.calculate)
        
        # Set focus
        self.budget_input.setFocus()
        
    def apply_theme(self):
        """Apply Tokyo Night theme"""
        # Set palette
        palette = QPalette()
        palette.setColor(QPalette.Window, QColor(TokyoNightColors.BACKGROUND))
        palette.setColor(QPalette.WindowText, QColor(TokyoNightColors.TEXT_PRIMARY))
        palette.setColor(QPalette.Base, QColor(TokyoNightColors.SURFACE_DARK))
        palette.setColor(QPalette.Text, QColor(TokyoNightColors.TEXT_PRIMARY))
        palette.setColor(QPalette.Button, QColor(TokyoNightColors.SURFACE))
        palette.setColor(QPalette.ButtonText, QColor(TokyoNightColors.TEXT_PRIMARY))
        palette.setColor(QPalette.Highlight, QColor(TokyoNightColors.ACCENT_BLUE))
        palette.setColor(QPalette.HighlightedText, QColor("white"))
        self.setPalette(palette)
        
        # Set general styles
        self.setStyleSheet(f"""
            QWidget {{
                background-color: {TokyoNightColors.BACKGROUND};
                color: {TokyoNightColors.TEXT_PRIMARY};
                font-family: 'Segoe UI', sans-serif;
            }}
            
            QLineEdit {{
                background-color: {TokyoNightColors.SURFACE_DARK};
                border: 2px solid {TokyoNightColors.BORDER};
                border-radius: 6px;
                padding: 10px;
                color: {TokyoNightColors.TEXT_PRIMARY};
                font-size: 13px;
                selection-background-color: {TokyoNightColors.ACCENT_BLUE};
                selection-color: white;
            }}
            
            QLineEdit:focus {{
                border: 2px solid {TokyoNightColors.ACCENT_BLUE};
                background-color: {TokyoNightColors.SURFACE};
            }}
            
            QLineEdit:hover {{
                border: 2px solid {TokyoNightColors.BORDER_LIGHT};
            }}
            
            QLabel {{
                color: {TokyoNightColors.TEXT_PRIMARY};
            }}
            
            QMessageBox {{
                background-color: {TokyoNightColors.SURFACE};
                color: {TokyoNightColors.TEXT_PRIMARY};
            }}
            
            QMessageBox QLabel {{
                color: {TokyoNightColors.TEXT_PRIMARY};
            }}
            
            QMessageBox QPushButton {{
                background-color: {TokyoNightColors.ACCENT_BLUE};
                color: white;
                border: none;
                border-radius: 4px;
                padding: 8px 16px;
                font-weight: bold;
                min-width: 80px;
            }}
            
            QMessageBox QPushButton:hover {{
                background-color: #8ab4f8;
            }}
        """)
        
    def center(self):
        """Center the window"""
        screen = QDesktopWidget().screenGeometry()
        window_size = self.geometry()
        x = (screen.width() - window_size.width()) // 2
        y = (screen.height() - window_size.height()) // 2
        self.move(x, y)
    
    def parse_input(self, text: str) -> Decimal:
        """Parse input into Decimal"""
        if not text:
            return Decimal('0')
        
        # Remove currency symbols and commas
        cleaned = re.sub(r'[$,]', '', text.strip())
        
        # Handle addition (+, &, and)
        if '+' in cleaned or '&' in cleaned or 'and' in cleaned.lower():
            parts = re.split(r'[+&]|and', cleaned, flags=re.IGNORECASE)
            total = Decimal('0')
            for part in parts:
                part = part.strip()
                if part:
                    try:
                        total += Decimal(part)
                    except:
                        pass
            return total
        
        # Single value
        try:
            return Decimal(cleaned)
        except:
            return Decimal('0')
    
    def calculate(self):
        """Calculate expenses and balance"""
        try:
            # Get values
            values = {}
            for field_name, widget in self.input_fields.items():
                values[field_name] = self.parse_input(widget.text())
            
            # Calculate
            budget = values['budget_input']
            expenses = sum(values[f] for f in [
                'mortgage_input', 'car1_input', 'car2_input',
                'utilities_input', 'entertainment_input', 'cell_phone_input'
            ])
            balance = budget - expenses
            
            # Format with thousand separators
            expenses_str = f"${expenses:,.2f}"
            balance_str = f"${balance:,.2f}"
            
            # Update display
            self.total_display.setText(expenses_str)
            self.balance_display.setText(balance_str)
            
            # Color code based on values
            if expenses > budget:
                total_color = TokyoNightColors.ACCENT_RED
                total_bg = "#3a1f23"  # Dark red background
            else:
                total_color = TokyoNightColors.ACCENT_GREEN
                total_bg = "#1f3a23"  # Dark green background
            
            if balance >= 0:
                balance_color = TokyoNightColors.ACCENT_GREEN
                balance_bg = "#1f3a23"  # Dark green background
            else:
                balance_color = TokyoNightColors.ACCENT_RED
                balance_bg = "#3a1f23"  # Dark red background
            
            # Apply styles to display labels
            self.total_display.setStyleSheet(f"""
                background-color: {total_bg};
                border: 2px solid {total_color};
                border-radius: 6px;
                padding: 10px;
                color: {total_color};
                font-weight: bold;
                font-size: 14px;
                min-width: 120px;
            """)
            
            self.balance_display.setStyleSheet(f"""
                background-color: {balance_bg};
                border: 2px solid {balance_color};
                border-radius: 6px;
                padding: 10px;
                color: {balance_color};
                font-weight: bold;
                font-size: 14px;
                min-width: 120px;
            """)
            
        except Exception as e:
            QMessageBox.warning(self, "Error", f"Invalid input: {str(e)}")
    
    def save_expenses(self):
        """Save expenses to CSV file"""
        try:
            # Calculate first
            self.calculate()
            
            # Get values
            values = {}
            for field_name, widget in self.input_fields.items():
                values[field_name] = float(self.parse_input(widget.text()))
            
            # Prepare data
            now = datetime.datetime.now()
            expenses = sum(values[f] for f in [
                'mortgage_input', 'car1_input', 'car2_input',
                'utilities_input', 'entertainment_input', 'cell_phone_input'
            ])
            budget = values['budget_input']
            balance = budget - expenses
            
            # Write to CSV
            file_exists = os.path.exists(self.csv_path)
            
            with open(self.csv_path, 'a', newline='') as csvfile:
                writer = csv.writer(csvfile)
                
                # Write header if file doesn't exist
                if not file_exists:
                    writer.writerow([
                        'Date', 'Budget', 'Mortgage/Rent', 'Car 1', 'Car 2',
                        'Utilities', 'Entertainment', 'Cell Phone',
                        'Total Expenses', 'Balance'
                    ])
                
                # Write data row
                writer.writerow([
                    now.strftime("%Y-%m-%d %H:%M:%S"),
                    budget,
                    values['mortgage_input'],
                    values['car1_input'],
                    values['car2_input'],
                    values['utilities_input'],
                    values['entertainment_input'],
                    values['cell_phone_input'],
                    expenses,
                    balance
                ])
            
            # Clear for next entry
            for widget in self.input_fields.values():
                widget.clear()
            
            # Reset displays
            self.total_display.setText("0.00")
            self.balance_display.setText("0.00")
            self.total_display.setStyleSheet("")
            self.balance_display.setStyleSheet("")
            
            self.budget_input.setFocus()
            
            QMessageBox.information(self, "✅ Saved", 
                                  f"Expenses saved successfully!\n\n"
                                  f"📊 Total: ${expenses:,.2f}\n"
                                  f"💰 Balance: ${balance:,.2f}\n"
                                  f"📁 Location: {self.csv_path}")
            
        except Exception as e:
            QMessageBox.critical(self, "❌ Save Error", 
                               f"Failed to save expenses:\n\n{str(e)}")
    
    def clear_all(self):
        """Clear all inputs"""
        for widget in self.input_fields.values():
            widget.clear()
        
        self.total_display.setText("0.00")
        self.balance_display.setText("0.00")
        
        # Reset display styles
        self.total_display.setStyleSheet("")
        self.balance_display.setStyleSheet("")
        
        self.budget_input.setFocus()
    
    def closeEvent(self, event):
        """Handle window close"""
        reply = QMessageBox.question(
            self, "🚪 Exit Application",
            "Are you sure you want to exit?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            event.accept()
        else:
            event.ignore()

# ==============================================
# Main
# ==============================================
if __name__ == '__main__':
    # Minimal dependency check
    try:
        from PyQt5.QtWidgets import QApplication
    except ImportError:
        print("Error: PyQt5 is required")
        print("Install with: pip install PyQt5")
        sys.exit(1)
    
    app = QApplication(sys.argv)
    app.setStyle('Fusion')
    
    calculator = ExpenseCalculator()
    calculator.show()
    
    sys.exit(app.exec_())