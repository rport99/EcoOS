#!/usr/bin/env python3
# eco_terminal.py - Modern Terminal Emulator with Tokyo Night Theme
# Robust + Intelligent Settings + Monospace-Enforced Fonts (Fastfetch-friendly)
# Restores full header bar controls: New Window, Split Intelligent, Split H/V, Close Split, Menu
#
# Fixes requested:
# ✅ Settings actually work (shared across windows + atomic save + validation)
# ✅ Settings dialog is MODAL (prevents main window stealing keys)
# ✅ Font size SpinButton +/− works (proper increments/numeric/snap/update policy)
# ✅ Monospace-only font chooser + enforced monospace fallback (fastfetch aligns)
# ✅ Header bar options restored

import gi
import os
import json
import sys
import signal
import tempfile

gi.require_version("Gtk", "3.0")
gi.require_version("Vte", "2.91")
from gi.repository import Gtk, Gdk, Vte, GLib, Pango, Gio


